#!/bin/bash -e

# If running the rails server then create or migrate existing database.
# Set SKIP_DB_PREPARE=1 on extra web containers once jobs or a second server are
# in play, so only one container touches the schema on deploy.
if [ -z "${SKIP_DB_PREPARE}" ] && [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
