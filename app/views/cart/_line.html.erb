<%#
  One line in the cart: the product's icon, its name over its category, what it
  costs, and a ✕ to drop it.

  The design puts "unit price × quantity" under the name and the line total on the
  right. There are no quantities here - everything sold is a digital file, so a
  line is one copy - which would make those two numbers the same figure printed
  twice. The category takes the subtitle slot instead, and the price stays where
  the design puts the total.

  locals: line
%>
<div class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 rounded-2xl border border-border-strong bg-surface p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:p-6">
  <div class="col-span-2 flex min-w-0 items-start gap-3 sm:col-span-1">
    <span class="shrink-0 text-t3 leading-title" aria-hidden="true"><%= line.product.display_icon %></span>
    <div class="min-w-0 flex-1">
      <%= link_to line.product.name, catalogue_product_path(line.product),
            class: "block rounded-md text-t5 font-bold text-cream no-underline [overflow-wrap:anywhere] hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
      <span class="mt-1 block text-t6 text-taupe"><%= line.product.kind_label %></span>
    </div>
  </div>
  <span class="min-w-0 text-t5 font-bold text-cream tabular-nums [overflow-wrap:anywhere]">
    <%= line.price_label || content_block("shop.card.unavailable") %>
  </span>
  <%= button_to cart_item_path(product_id: line.product.id), method: :delete,
        class: "flex size-11 items-center justify-center rounded-lg border-0 bg-transparent text-taupe hover:bg-ink-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent cursor-pointer",
        form_class: "contents", "aria-label": t("nav.remove_from_cart") do %>
    <%= icon "x", class: "size-5" %>
  <% end %>
</div>
