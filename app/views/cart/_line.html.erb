<%#
  One line in the cart: the product's icon, its name over its category, what it
  costs, and a ✕ to drop it.

  The design puts "unit price × quantity" under the name and the line total on the
  right. There are no quantities here — everything sold is a digital file, so a
  line is one copy — which would make those two numbers the same figure printed
  twice. The category takes the subtitle slot instead, and the price stays where
  the design puts the total.

  locals: line
%>
<div class="flex items-center gap-4 rounded-2xl border border-border-strong bg-surface px-5.5 py-4.5">
  <span class="text-[30px] leading-none" aria-hidden="true"><%= line.product.display_icon %></span>

  <div class="flex-1 min-w-0">
    <%= link_to line.product.name, product_path(line.product),
          class: "block text-[15px] font-bold text-cream no-underline hover:text-accent truncate" %>
    <span class="text-[13px] text-taupe"><%= line.product.kind_label %></span>
  </div>

  <span class="text-[15px] font-extrabold text-cream tabular-nums whitespace-nowrap">
    <%= line.price_label || content_block("shop.card.unavailable") %>
  </span>

  <%= button_to cart_item_path(product_id: line.product.id), method: :delete,
        class: "cursor-pointer border-0 bg-transparent px-2 py-1 text-[20px] leading-none text-taupe hover:text-accent",
        form_class: "contents", "aria-label": t("nav.remove_from_cart") do %>
    ✕
  <% end %>
</div>
