<% content_for :title, page_title(@product.name) %>
<%# One shared purchase area, followed by the appropriate product-kind details.
    Optional content never creates empty headings. %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :left
  ) do |section| %>
    <div class="max-w-[1080px] mx-auto w-full">
      <% collection_key = @product.audio_process? ? "processes" : "stories" %>
      <nav aria-label="<%= t('products.category_navigation') %>" class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <%= link_to product_collection_path(@product), class: "group inline-flex min-h-11 min-w-11 items-center gap-1.5 py-3 text-t6 font-bold text-accent no-underline hover:text-accent-hover rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" do %>
          <%= icon "arrow-left", class: "size-3.5 shrink-0 transition-transform duration-100 group-hover:-translate-x-0.5" %>
          <%= content_block("shop.product.back_#{collection_key}") %>
        <% end %>
        <%= link_to t("nav.shop"), products_path, class: "inline-flex min-h-11 items-center rounded-md py-3 text-t6 font-bold text-tan no-underline hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
      </nav>

      <% has_trailer = @product.trailerable? %>
      <% if @product.audio_process? %>
        <h1 class="mt-6.5 mb-0 font-display text-t1 font-bold text-cream text-pretty [overflow-wrap:anywhere]">
          <%= @product.name %>
        </h1>
      <% end %>
      <div class="mt-6.5 grid grid-cols-1 items-start gap-7 md:grid-cols-2 md:gap-12">
        <div class="product-identity flex min-w-0 flex-col gap-4 md:order-2">
          <% unless @product.audio_process? %>
            <h1 class="m-0 font-display text-t1 font-bold text-cream text-pretty [overflow-wrap:anywhere]">
              <%= @product.name %>
            </h1>
            <p class="m-0 text-t6 text-taupe"><%= @product.kind_label %></p>
          <% end %>

          <% if @product.description.present? %>
            <p class="m-0 text-t4 text-tan text-pretty [overflow-wrap:anywhere]"><%= @product.description %></p>
          <% end %>

          <% price_label = product_price_label(@product) %>

          <p class="mt-1 font-display text-t2 font-bold text-cream tabular-nums"><%= price_label || content_block("shop.card.unavailable") %></p>

          <%# Between the price and the ask: after the reason to want it, before
              the commitment. Skipped for someone who already owns the recording -
              they get the full player in the dashboard, and offering an owner a
              sample of their own file is a smaller offer than they already have.
              preload="none" so a page view costs no bandwidth, and the native
              control rather than a custom transport so keyboard and screen-reader
              behaviour come for free. %>
          <%= render "products/preview", product: @product %>

          <%= render "products/cart_actions", product: @product %>

          <% if @product.length_label || !@product.audio_process? %>
            <dl class="mt-3 grid gap-3 border-t border-border pt-5.5 [grid-template-columns:repeat(auto-fit,minmax(120px,1fr))]">
              <% if @product.length_label %>
                <%= render "products/spec_item", label: content_block("shop.product.length"), value: @product.length_label %>
              <% end %>
              <%= render "products/delivery_specs" unless @product.audio_process? %>
            </dl>
          <% end %>
        </div>

        <%# DOM order stays identity first for both media states. Desktop places
            supporting media in the left column; phones keep it below the offer. %>
        <div class="product-media min-w-0 md:order-1">
          <% if has_trailer %>
            <%= render "products/trailer", product: @product, spacing: false %>
          <% else %>
            <div class="flex aspect-video items-center justify-center rounded-3xl border border-border-strong bg-linear-[135deg,var(--color-border-strong),var(--color-ink)] text-[110px] md:aspect-square"
                 aria-hidden="true"><%= @product.display_icon %></div>
          <% end %>
          <% if @product.audio_process? %>
            <dl class="mt-6 grid gap-4 border-t border-border pt-6 [grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr))]">
              <%= render "products/delivery_specs" %>
            </dl>
          <% end %>
        </div>
      </div>

      <% if @product.audio_process? %>
        <%= render "products/audio_process_details", product: @product %>
      <% else %>
        <%= render "products/bedtime_story_details", product: @product %>
      <% end %>

      <% if @also.any? %>
        <section aria-labelledby="related-products-title" class="mt-12 md:mt-20 border-t border-border pt-9">
          <h2 id="related-products-title" class="mb-5.5 font-display font-bold text-t3 text-cream [overflow-wrap:anywhere]">
            <%= content_block("shop.product.more_#{collection_key}") %>
          </h2>

          <%# capped like the shop grid: a catalogue of two leaves exactly one tile
              here, and uncapped it ran the full column width. %>
          <% also_cap = { 1 => "sm:max-w-[360px]", 2 => "sm:max-w-[738px]" }[@also.size] %>
          <div class="grid gap-4.5 <%= also_cap %> [grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))]">
            <% @also.each do |other| %>
              <%= render "products/also_card", product: other %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
