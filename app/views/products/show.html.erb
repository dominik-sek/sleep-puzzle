<% content_for :title, page_title(@product.name) %>
<%# The design's Produkt screen: a big icon panel beside the buy column, then the
    prose and the "co dostajesz" bullets, then three other products.

    Every section below the fold is skipped when the owner has not filled it in -
    a product with no long description and no bullets renders as just the top
    half rather than as empty headings. %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :left
  ) do |section| %>
    <div class="max-w-[1080px] mx-auto w-full">
      <%= link_to products_path, class: "group inline-flex items-center gap-1.5 py-2 text-t6 font-bold text-accent no-underline hover:text-accent-hover rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" do %>
        <%= icon "arrow-left", class: "size-3.5 shrink-0 transition-transform duration-100 group-hover:-translate-x-0.5" %>
        <%= content_block("shop.product.back") %>
      <% end %>

      <div class="mt-6.5 grid items-start gap-7 md:gap-12 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]">
        <div class="flex aspect-square items-center justify-center rounded-3xl border border-border-strong bg-linear-[135deg,var(--color-border-strong),var(--color-ink)] text-[110px]"
             aria-hidden="true">
          <%= @product.display_icon %>
        </div>

        <div class="flex flex-col gap-4">
          <span class="text-t6 uppercase text-taupe">
            <%= @product.kind_label %>
          </span>

          <h1 class="font-display font-bold text-t1 text-cream text-pretty m-0">
            <%= @product.name %>
          </h1>

          <% if @product.description.present? %>
            <p class="text-t4 text-tan text-pretty m-0"><%= @product.description %></p>
          <% end %>

          <% price_label = product_price_label(@product) %>

          <div class="mt-1 flex items-baseline gap-3.5">
            <span class="font-display font-bold text-t2 text-cream tabular-nums">
              <%= price_label || content_block("shop.card.unavailable") %>
            </span>
            <% if @product.length_label %>
              <span class="text-t6 font-semibold text-taupe"><%= @product.length_label %></span>
            <% end %>
          </div>

          <%# Between the price and the ask: after the reason to want it, before
              the commitment. Skipped for someone who already owns the recording -
              they get the full player in the dashboard, and offering an owner a
              sample of their own file is a smaller offer than they already have.
              preload="none" so a page view costs no bandwidth, and the native
              control rather than a custom transport so keyboard and screen-reader
              behaviour come for free. %>
          <% if @product.previewable? && !current_user&.purchased?(@product) %>
            <div class="flex flex-col gap-2">
              <span class="text-t6 uppercase text-taupe">
                <%= content_block("shop.product.preview") %>
              </span>
              <audio controls preload="none" class="w-full"
                     src="<%= preview_product_path(@product) %>"
                     aria-label="<%= t('products.player.preview_label', name: @product.name) %>"></audio>
            </div>
          <% end %>

          <%= render "products/cart_actions", product: @product %>

          <dl class="mt-3 grid gap-3 border-t border-border pt-5.5 [grid-template-columns:repeat(auto-fit,minmax(120px,1fr))]">
            <% if @product.length_label %>
              <%= render "products/spec_item", label: content_block("shop.product.length"), value: @product.length_label %>
            <% end %>
            <%= render "products/spec_item", label: content_block("shop.product.format"),
                       value: content_block("shop.product.format_value") %>
            <%= render "products/spec_item", label: content_block("shop.product.access"),
                       value: content_block("shop.product.access_value") %>
          </dl>
        </div>
      </div>

      <% if @product.long_description.present? || @product.includes.any? %>
        <div class="mt-11 md:mt-16 grid gap-7 md:gap-12 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
          <% if @product.long_description.present? %>
            <div>
              <h2 class="mb-3.5 font-display font-bold text-t3 text-cream">
                <%= content_block("shop.product.about") %>
              </h2>
              <%# a product with no bullets leaves this column alone in the grid,
                  and the measure ran past 100ch. 70ch is the system's ceiling. %>
              <p class="text-t5 leading-[1.75] text-tan text-pretty m-0 max-w-[70ch]"><%= @product.long_description %></p>
            </div>
          <% end %>

          <% if @product.includes.any? %>
            <div>
              <h2 class="mb-3.5 font-display font-bold text-t3 text-cream">
                <%= content_block("shop.product.includes") %>
              </h2>
              <ul class="flex flex-col gap-3 list-none p-0 m-0">
                <% @product.includes.each do |item| %>
                  <li class="flex items-start gap-3">
                    <%# the system's own mark, not a font glyph: U+2726 sits outside both
                        self-hosted subsets and renders from the OS fallback %>
                    <%= icon "astroid", class: "size-4 shrink-0 mt-1 text-accent" %>
                    <span class="text-t5 text-cream"><%= item %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @also.any? %>
        <div class="mt-12 md:mt-20 border-t border-border pt-9">
          <h2 class="mb-5.5 font-display font-bold text-t3 text-cream">
            <%= content_block("shop.product.more") %>
          </h2>

          <%# capped like the shop grid: a catalogue of two leaves exactly one tile
              here, and uncapped it ran the full column width. %>
          <% also_cap = { 1 => "sm:max-w-[360px]", 2 => "sm:max-w-[738px]" }[@also.size] %>
          <div class="grid gap-4.5 <%= also_cap %> [grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))]">
            <% @also.each do |other| %>
              <%= render "products/also_card", product: other %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
