<%#
  The one control that puts a product in the cart, so the shop grid and the
  product page cannot drift apart.

  A real form rather than a link: adding to the cart changes state, and a GET
  that mutates gets fired by every link prefetcher going.

  locals: product
%>
<%= form_with url: cart_items_path, class: "contents" do |form| %>
  <%= form.hidden_field :product_id, value: product.id %>
  <%= form.button type: :submit,
        class: "cursor-pointer whitespace-nowrap rounded-[20px] border-0 bg-accent px-4 py-2.5 text-[13px] font-bold text-ink hover:bg-accent-hover" do %>
    <%= content_block("shop.card.add") %>
  <% end %>
<% end %>
