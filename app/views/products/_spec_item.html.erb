<%#
  One label/value pair in the product's spec strip - length, format, access.

  locals: label, value
%>
<div class="flex min-w-0 flex-col gap-1.25 [overflow-wrap:anywhere]">
  <dt class="text-t6 uppercase text-taupe"><%= label %></dt>
  <dd class="text-t6 font-bold text-cream m-0"><%= value %></dd>
</div>
