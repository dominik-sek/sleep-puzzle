<%#
  One label/value pair in the product's spec strip — length, format, access.

  locals: label, value
%>
<div class="flex flex-col gap-1.25">
  <dt class="text-[11px] font-extrabold uppercase tracking-[0.5px] text-taupe"><%= label %></dt>
  <dd class="text-t6 font-bold text-cream m-0"><%= value %></dd>
</div>
