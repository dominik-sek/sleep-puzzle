<% content_for :title, page_title(t("nav.shop")) %>
<div class="shop-index mx-auto w-full max-w-[1240px] px-[clamp(20px,4vw,28px)] pb-[clamp(56px,8vw,90px)]">
  <header class="pt-[clamp(40px,6vw,64px)] pb-[clamp(28px,4vw,40px)]">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <h1 class="page-title min-w-0"><%= content_block("shop.hero.title") %></h1>
      <%= render "shared/cart_pill" %>
    </div>
    <p class="page-subtitle mt-3 max-w-[58ch]"><%= content_block("shop.hero.subtitle") %></p>
    <% unless user_signed_in? %>
      <p class="mt-2.5 text-t6 font-medium text-taupe">
        <%= content_block("shop.hero.returning") %>
        <%= link_to t("nav.sign_in"), new_user_session_path,
                    class: "inline-flex min-h-11 items-center rounded-md font-bold text-accent no-underline hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
      </p>
    <% end %>
  </header>

  <% if @packages.any? %>
    <section id="packages" tabindex="-1" aria-labelledby="packages-title" class="shop-section scroll-mt-24 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <h2 id="packages-title" class="shop-section-title"><%= t("offers.one_to_one") %></h2>
      <p class="mt-1.5 max-w-[62ch] text-t5 text-tan text-pretty"><%= shop_collaboration_intro %></p>
      <%# The second published package leads, matching the approved composition.
          With one package, it takes the spotlight; all other records stay visible. %>
      <% featured = @packages.second || @packages.first %>
      <% supporting = @packages.reject { |package| package == featured } %>
      <div class="mt-[22px] grid items-start gap-x-9 gap-y-6 <%= 'lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]' if supporting.any? %>">
        <%= render "products/package_spotlight", package: featured, featured: true %>
        <% if supporting.any? %>
          <div class="shop-package-list min-w-0">
            <% supporting.each do |package| %>
              <%= render "products/package_spotlight", package: package, featured: false %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% grouped_products = @products.group_by(&:kind) %>
  <% processes = grouped_products.fetch("audio_process", []) %>
  <section id="audio-processes" tabindex="-1" aria-labelledby="audio-processes-title" class="shop-section scroll-mt-24 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-1.5">
      <div class="min-w-0">
        <h2 id="audio-processes-title" class="shop-section-title"><%= t("offers.audio") %></h2>
        <p class="mt-1.5 max-w-[62ch] text-t5 text-tan text-pretty"><%= content_block("shop.collections.processes_intro") %></p>
      </div>
      <%= render "products/collection_link", label: content_block("shop.collections.processes_link"), path: audio_processes_path %>
    </div>
    <div class="mt-[22px]">
      <% if processes.any? %>
        <%= render "products/shelf", products: processes %>
      <% else %>
        <p class="text-t5 text-taupe"><%= content_block("shop.collections.processes_empty") %></p>
      <% end %>
    </div>
  </section>

  <% stories = grouped_products.fetch("bedtime_story", []) %>
  <section id="stories" tabindex="-1" aria-labelledby="stories-title" class="mt-6 scroll-mt-24 rounded-md border-t border-border pt-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
    <div class="grid items-baseline gap-x-8 gap-y-1 lg:grid-cols-[200px_minmax(0,1fr)_auto]">
      <h2 id="stories-title" class="font-display text-[1.375rem] leading-heading font-bold text-cream"><%= t("offers.stories") %></h2>
      <div class="min-w-0">
        <p class="text-t5 text-tan"><%= content_block("shop.collections.stories_intro") %></p>
        <% if stories.empty? %>
          <p class="mt-0.5 text-t6 font-medium text-taupe"><%= content_block("shop.collections.stories_empty") %></p>
        <% end %>
      </div>
      <%= render "products/collection_link", label: content_block("shop.collections.stories_link"), path: stories_path %>
    </div>
    <% if stories.any? %>
      <div class="mt-4"><%= render "products/grid", products: stories, heading: :h3 %></div>
    <% end %>
  </section>
</div>
