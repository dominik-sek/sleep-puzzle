<% content_for :title, page_title(t("nav.shop")) %>
<%# The design's Sklep: a left-aligned heading with the cart pill opposite it, not
    the centred hero the other catalogue screens use. %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :left
  ) do |section| %>
    <div class="max-w-[1240px] mx-auto w-full">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-11">
        <div>
          <h1 class="text-t2 font-display font-bold text-cream mb-2.5">
            <%= content_block("shop.hero.title") %>
          </h1>
          <p class="text-t5 text-tan max-w-[520px] m-0">
            <%= content_block("shop.hero.subtitle") %>
          </p>
        </div>

        <%= render "shared/cart_pill" %>
      </div>

      <% if @products.any? %>
        <%# auto-fit rather than fixed breakpoints, as the design has it: the grid
            fits as many 240px cards as the row has room for %>
        <div class="grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]">
          <% @products.each do |product| %>
            <%= render "products/card", product: product %>
          <% end %>
        </div>
      <% else %>
        <p class="text-t4 text-tan max-w-2xl">
          <%= content_block("shop.empty.body") %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
