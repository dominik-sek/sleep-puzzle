<%#
  The shop card's add/remove button, in a region the cart_items streams replace —
  press "Dodaj" on the grid and that card's button becomes "Usuń" without the page
  reloading.

  The product page uses products/cart_actions instead, which streams the button
  together with everything else that depends on the cart.

  locals: product
%>
<%= tag.span id: dom_id(product, :cart_toggle), class: "flex flex-col items-stretch gap-1.5" do %>
  <%= render "products/cart_button", product: product %>

  <%# the grid used to confirm an add only by flipping the button to "Usuń" —
      a destructive verb in the same pixels the thumb just left. Saying "Dodano"
      as well makes the confirmation an addition, not a substitution. %>
  <% if current_cart.include?(product) %>
    <span class="flex items-center justify-center gap-1 text-t6 font-bold text-accent" aria-live="polite">
      <%= icon "circle-check", class: "size-3.5 shrink-0" %>
      <%= content_block("shop.card.added") %>
    </span>
  <% end %>
<% end %>
