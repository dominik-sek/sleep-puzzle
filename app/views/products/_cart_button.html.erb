<%#
  The add/remove control itself, with no wrapper of its own so the caller decides
  what turbo replaces. One control rather than two, because a digital file is
  either in the cart or it is not — there is no quantity to nudge, so a second
  press should undo the first.

  Both branches are real forms, not links: they change state, and a GET that
  mutates gets fired by every link prefetcher going.

  locals: product, size (:sm on a shop card, :lg on the product page)
%>
<% size = local_assigns.fetch(:size, :sm) %>
<%
  shape = size == :lg ? "rounded-[26px] px-6.5 py-3.5 text-[15px]" : "rounded-[20px] px-4 py-2.5 text-[13px]"
%>

<% if current_user&.purchased?(product) %>
  <%# bought already, and a digital file is bought once — so this leads to where
      it actually is rather than offering to sell it again. The server refuses the
      add too; this is the half the buyer can see. %>
  <%= link_to content_block("shop.card.owned"), dashboard_index_path,
        class: class_names(
          "whitespace-nowrap border-[1.5px] border-accent bg-transparent font-bold text-accent no-underline hover:bg-accent hover:text-ink",
          shape
        ) %>
<% elsif current_cart.include?(product) %>
  <%= button_to cart_item_path(product_id: product.id), method: :delete,
        form_class: "contents",
        class: class_names(
          "cursor-pointer whitespace-nowrap border-[1.5px] border-taupe-dark bg-transparent font-bold text-cream hover:border-accent hover:text-accent",
          shape
        ) do %>
    <%= content_block("shop.card.remove") %>
  <% end %>
<% else %>
  <%= form_with url: cart_items_path, class: "contents" do |form| %>
    <%= form.hidden_field :product_id, value: product.id %>
    <%= form.button type: :submit,
          class: class_names(
            "cursor-pointer whitespace-nowrap border-0 bg-accent font-bold text-ink hover:bg-accent-hover",
            shape
          ) do %>
      <%= content_block("shop.card.add") %>
    <% end %>
  <% end %>
<% end %>
