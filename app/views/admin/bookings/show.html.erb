<% content_for :title, "#{@booking.name} - Panel" %>

<div class="p-6 sm:p-8 flex flex-col gap-6 max-w-[800px]">
  <div class="flex flex-col gap-2">
    <a href="<%= admin_bookings_path %>" class="text-t6">← Rezerwacje</a>

    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-t2 font-display text-cream"><%= @booking.name %></h1>
      <%= admin_status_badge @booking.status,
            @booking.status_label,
            classes: "text-t6 font-medium" %>
    </div>
  </div>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border-strong rounded-xl border border-border-strong overflow-hidden">
    <% [
         [ "Termin", @booking.starts_at ? l(@booking.starts_at, format: :long) : "-" ],
         [ "Pakiet", @booking.package.name ],
         [ "Email", @booking.email ],
         [ "Konto", @booking.user.email ],
         [ "Utworzono", l(@booking.created_at, format: :long) ],
         [ "Potwierdzono", @booking.confirmed_at ? l(@booking.confirmed_at, format: :long) : "-" ]
       ].each do |label, value| %>
      <div class="bg-surface px-4 py-3 flex flex-col gap-1">
        <dt class="text-t6 uppercase text-taupe"><%= label %></dt>
        <dd class="text-t5 text-cream m-0"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <%# the two external ids: what to search for in Paddle and Google Calendar when
      a booking looks wrong. A blank calendar id means the slot is not held. %>
  <dl class="grid grid-cols-1 gap-px bg-border-strong rounded-xl border border-border-strong overflow-hidden">
    <div class="bg-surface px-4 py-3 flex flex-col gap-1">
      <dt class="text-t6 uppercase text-taupe">Transakcja Paddle</dt>
      <dd class="text-t6 text-tan m-0 font-mono break-all">
        <%= @booking.paddle_transaction_id.presence || "-" %>
      </dd>
    </div>
    <div class="bg-surface px-4 py-3 flex flex-col gap-1">
      <dt class="text-t6 uppercase text-taupe">Wydarzenie w kalendarzu</dt>
      <dd class="text-t6 text-tan m-0 font-mono break-all">
        <% if (calendar_url = google_calendar_event_url(@booking)) %>
          <%= link_to calendar_url, target: "_blank", rel: "noopener noreferrer",
                      class: "inline-flex items-center gap-1.5 font-sans" do %>
            Otwórz w Google Calendar
            <%= icon "external-link", class: "size-3.5 shrink-0" %>
          <% end %>
          <div class="mt-1 text-taupe"><%= @booking.calendar_event_id %></div>
        <% elsif @booking.calendar_event_id.present? %>
          <%= @booking.calendar_event_id %>
        <% else %>
          <span class="text-taupe font-sans">Brak - termin nie jest zablokowany w kalendarzu</span>
        <% end %>
      </dd>
    </div>
  </dl>
</div>
