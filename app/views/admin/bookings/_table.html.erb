<%= render Table::Component.new(hoverable: true) do |table| %>
  <% table.with_column(label: "Termin") %>
  <% table.with_column(label: "Klient") %>
  <% table.with_column(label: "Pakiet") %>
  <% table.with_column(label: "Stan rezerwacji") %>
  <% table.with_column(label: "Zwrot") %>
  <% table.with_column(label: "Utworzono") %>

  <% bookings.each do |booking| %>
    <% table.with_row do |row| %>
      <% row.with_cell(primary: true, classes: "tabular-nums whitespace-nowrap") do %>
        <%= booking.starts_at ? l(booking.starts_at, format: :short) : "-" %>
      <% end %>

      <% row.with_cell(primary: true) do %>
        <div><%= link_to booking.name, admin_booking_path(booking) %></div>
        <div class="text-taupe"><%= booking.email %></div>
      <% end %>

      <% row.with_cell do %>
        <%= booking.package.name %>
      <% end %>

      <% row.with_cell do %>
        <%= admin_status_badge booking.status,
              booking.status_label %>
      <% end %>

      <% row.with_cell(classes: "tabular-nums whitespace-nowrap") do %>
        <% refund_state = booking.refund_state %>
        <%= t("refunds.states.#{refund_state}") %>
        <% if booking.status.in?(%w[pending confirmed]) && refund_state.in?(%w[pending_approval partial full]) %>
          <%= link_to "Sprawdź aktywną rezerwację", admin_booking_path(booking), class: "block text-accent font-bold whitespace-normal" %>
        <% end %>
      <% end %>

      <% row.with_cell(classes: "tabular-nums whitespace-nowrap") do %>
        <%= l booking.created_at, format: :short %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
