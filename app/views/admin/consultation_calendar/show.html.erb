<% content_for :title, "Kalendarz konsultacji - Panel" %>
<div class="p-4 pt-16 sm:p-8 w-full min-w-0 flex flex-col gap-6 max-w-[1400px]"
     data-controller="consultation-calendar"
     data-consultation-calendar-day-url-value="<%= day_admin_consultation_calendar_path %>"
     data-consultation-calendar-bulk-url-value="<%= bulk_admin_consultation_blocks_path %>"
     data-action="turbo:before-stream-render@window->consultation-calendar#beforeStream turbo:before-cache@document->consultation-calendar#beforeCache">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div><h1 class="font-display text-t2">Kalendarz konsultacji</h1><p class="text-taupe">Konsultacje trwają 90 minut. Wszystkie godziny: Warszawa.</p></div>
    <%= link_to "Harmonogram i ustawienia", edit_admin_consultation_settings_path, class: "rounded-full bg-accent px-5 py-3 text-ink font-bold no-underline" %>
  </div>
  <% unless @calendar.settings.local_availability? %>
    <div role="status" class="rounded-xl border border-yellow-400/30 bg-surface p-4 text-yellow-300">Trwa przenoszenie kalendarza. Klientów nadal obowiązują także blokady Google. Ten podgląd pokazuje terminy i blokady w aplikacji. Przepisz blokady z Google, a następnie przełącz dostępność w ustawieniach.</div>
  <% end %>
  <%= render "notice", message: nil, conflicts: [] %>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" data-consultation-calendar-target="modeButton" data-action="consultation-calendar#toggleSelectionMode" aria-pressed="false"
            class="rounded-full border border-border-input px-5 py-3 cursor-pointer">Zaznacz dni</button>
    <p class="text-t6 text-taupe" data-consultation-calendar-target="hint">Kliknij dzień, aby zobaczyć szczegóły i dostępne akcje.</p>
  </div>
  <div hidden data-consultation-calendar-target="selectionBar" class="rounded-xl border border-accent bg-surface p-4 flex flex-wrap items-center gap-3">
    <span role="status" aria-live="polite" data-consultation-calendar-target="selectionCount"></span>
    <button type="button" data-consultation-calendar-target="bulkButton" data-action="consultation-calendar#openBulk" class="rounded-full bg-accent px-4 py-2 text-ink font-bold cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">Zablokuj zaznaczone</button>
    <button type="button" data-action="consultation-calendar#clearSelection" class="rounded-full border border-border-input px-4 py-2 cursor-pointer">Wyczyść</button>
  </div>
  <%= render "month", calendar: @calendar %>
  <%= render "lists", calendar: @calendar %>
  <dialog class="consultation-calendar-dialog rounded-2xl border border-border bg-surface text-cream shadow-xl"
          aria-label="Zarządzanie dostępnością konsultacji" data-consultation-calendar-target="dialog"
          data-action="click->consultation-calendar#backdrop cancel->consultation-calendar#cancel close->consultation-calendar#closed">
    <div class="sticky top-0 z-10 bg-surface flex items-center justify-between gap-4 border-b border-border px-5 py-3">
      <span class="text-t6 text-taupe">Kalendarz konsultacji</span>
      <button type="button" aria-label="Zamknij okno" data-action="consultation-calendar#close" class="rounded-full border border-border-input px-3 py-2 cursor-pointer">Zamknij</button>
    </div>
    <%= turbo_frame_tag "consultation_calendar_dialog", data: { consultation_calendar_target: "dialogFrame", action: "turbo:frame-load->consultation-calendar#dialogLoaded turbo:frame-missing->consultation-calendar#frameMissing turbo:fetch-request-error->consultation-calendar#frameError" } %>
  </dialog>
</div>
