<% content_for :title, "Opinie - Panel" %>

<div class="flex max-w-[1100px] flex-col gap-8 p-6 sm:p-8">
  <div>
    <h1 class="font-display text-t2 text-cream">Opinie</h1>
    <p class="mt-2 text-t5 text-taupe">Utwórz osobny prywatny link dla każdej osoby i wyślij go samodzielnie. Zgłoszenia wymagają zatwierdzenia. Opublikowane opinie i ich kolejność edytujesz w <%= link_to "Treściach", admin_content_blocks_path(open: "testimonials.entries"), class: "text-accent" %>.</p>
  </div>

  <section class="rounded-xl border border-border-strong bg-surface p-5">
    <h2 class="font-display text-t3 text-cream">Nowy link</h2>
    <%= form_with url: admin_testimonial_invitations_path, method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex min-w-56 flex-1 flex-col gap-2">
        <%= f.label :recipient_label, "Dla kogo (widoczne tylko w panelu)", class: "text-t6 text-tan" %>
        <%= f.text_field :recipient_label, required: true, maxlength: 100, class: "form-control" %>
      </div>
      <%= f.submit "Utwórz link", class: "rounded-full bg-accent px-5 py-3 font-bold text-ink cursor-pointer" %>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="font-display text-t3 text-cream">Zaproszenia i zgłoszenia</h2>
    <% if @invitations.empty? %>
      <p class="text-t5 text-taupe">Nie ma jeszcze zaproszeń.</p>
    <% end %>
    <% @invitations.each do |invitation| %>
      <article class="rounded-xl border border-border-strong bg-surface p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-bold text-cream"><%= invitation.recipient_label %></h3>
          <span class="text-t6 text-tan"><%= { "open" => "Link gotowy", "submitted" => "Do zatwierdzenia", "approved" => "Zatwierdzona", "declined" => "Odrzucona" }.fetch(invitation.status) %></span>
        </div>
        <% if invitation.open? %>
          <div class="mt-4 flex flex-col gap-2 text-t6 text-tan" data-controller="copy">
            <label for="invitation_url_<%= invitation.id %>">Prywatny link do wysłania</label>
            <div class="flex flex-wrap gap-2">
              <%= text_field_tag "invitation_url_#{invitation.id}", testimonial_invitation_url(invitation.token, locale: nil), readonly: true,
                                 data: { copy_target: "source" }, class: "form-control min-w-0 flex-1 text-t6" %>
              <button type="button" data-action="copy#copy" data-copy-target="button"
                      class="rounded-full border border-border-input px-4 py-2 text-tan cursor-pointer hover:text-cream">Kopiuj link</button>
            </div>
          </div>
        <% elsif invitation.submitted? %>
          <blockquote class="mt-4 whitespace-pre-line text-t5 text-cream"><%= invitation.quote %></blockquote>
          <p class="mt-3 text-t6 text-tan">— <%= invitation.author %> · <%= invitation.locale.to_s.upcase %></p>
          <div class="mt-5 flex flex-wrap gap-3">
            <%= button_to "Zatwierdź i opublikuj", approve_admin_testimonial_invitation_path(invitation), method: :post,
                          class: "rounded-full bg-accent px-5 py-2 font-bold text-ink cursor-pointer" %>
            <%= button_to "Odrzuć", decline_admin_testimonial_invitation_path(invitation), method: :post,
                          data: { turbo_confirm: "Odrzucić tę opinię?" },
                          class: "rounded-full border border-border-input px-5 py-2 text-tan cursor-pointer" %>
          </div>
        <% elsif invitation.approved? %>
          <p class="mt-3 text-t6 text-taupe">Treść, kolejność i widoczność ustawisz w Treściach.</p>
        <% end %>
      </article>
    <% end %>
  </section>
</div>
