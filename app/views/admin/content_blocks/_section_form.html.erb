<div id="section-<%= page.key %>-<%= section.key %>" class="scroll-mt-6">
  <%# multipart: a section may carry an image field, and a file input in a form
      posted as urlencoded uploads nothing but the filename %>
  <%= form_with url: admin_content_blocks_path, method: :patch, multipart: true,
                class: "flex flex-col gap-6" do %>
    <%# id: nil - five section forms on one page would otherwise all be id="section" %>
    <%= hidden_field_tag :section, section.full_key, id: nil %>

    <% section.fields.each do |field| %>
      <% if field.image? %>
        <%= render "admin/content_blocks/image_input",
                   section: section, field: field, block: blocks[field.full_key] %>
      <% else %>
        <div class="flex flex-col gap-2">
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="text-t6 uppercase text-taupe"><%= field.label %></span>
            <span class="text-t6 font-mono text-taupe-dark"><%= field.full_key %></span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <% ContentBlock::LOCALES.each do |locale| %>
              <%= render "admin/content_blocks/field_input",
                         section: section, field: field, block: blocks[field.full_key], locale: locale %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if section.collection? %>
      <%= render "admin/content_blocks/collection_fields",
                 collection: section.collection, items: items %>
    <% end %>

    <div class="flex items-center gap-3">
      <%= submit_tag "Zapisz sekcję",
                     class: "inline-flex items-center justify-center rounded-lg border border-accent-terracotta/30 bg-accent px-3.5 py-2 text-sm font-medium text-ink shadow-sm cursor-pointer hover:bg-accent-hover" %>
    </div>
  <% end %>

  <% if section.collection? %>
    <%# outside the form above on purpose - button_to would nest a <form> %>
    <div class="mt-4">
      <%= link_to admin_content_items_path(collection_key: section.full_key),
                  data: { turbo_method: :post },
                  class: "inline-flex items-center gap-1.5 rounded-lg border border-border-input bg-surface px-3 py-2 text-t6 font-medium text-cream no-underline hover:bg-ink-soft" do %>
        <%= icon "file-text", class: "size-3.5 shrink-0" %>
        Dodaj: <%= section.collection.item_label.downcase %>
      <% end %>
    </div>
  <% end %>
</div>
