<div id="section-<%= page.key %>-<%= section.key %>" data-preview-section="<%= section.full_key %>" class="min-w-0">
  <%# multipart is required when this section contains an image field. %>
  <%= form_with url: admin_content_blocks_path, method: :patch, multipart: true,
                data: { content_blocks_target: "form", action: "submit->content-blocks#submit" },
                class: "flex flex-col gap-0 min-w-0" do %>
    <%= hidden_field_tag :section, section.full_key, id: nil %>
    <%= hidden_field_tag :lang, editor_locale, id: "content-editor-lang", data: { content_blocks_target: "langInput" } %>

    <div class="sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 border-b border-border-strong bg-surface px-4 py-3 sm:px-6">
      <div role="group" aria-label="Język edycji" class="inline-flex rounded-lg border border-border-input bg-ink-soft p-1">
        <% ContentBlock::LOCALES.each do |locale| %>
          <button type="button" data-content-blocks-target="languageTab"
                  data-lang="<%= locale %>" data-action="click->content-blocks#selectLanguage"
                  aria-pressed="<%= editor_locale == locale.to_s %>"
                  class="rounded-md px-3 py-1.5 text-t6 cursor-pointer <%= editor_locale == locale.to_s ? 'bg-accent text-ink' : 'text-tan hover:text-cream' %>">
            <%= locale == :pl ? "Polski" : "English" %>
          </button>
        <% end %>
      </div>
      <%= submit_tag "Zapisz sekcję",
                     class: "inline-flex items-center justify-center rounded-lg border border-accent-terracotta/30 bg-accent px-4 py-2 text-sm font-medium text-ink shadow-sm cursor-pointer hover:bg-accent-hover" %>
    </div>

    <div class="flex flex-col gap-6 p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p data-content-blocks-target="englishNote" <%= "hidden" unless editor_locale == "en" %>
           class="text-t6 text-taupe">Puste pola angielskie wyświetlają polską treść na stronie.</p>
        <button type="button" data-action="click->content-blocks#showSection"
                class="inline-flex items-center gap-2 rounded-lg border border-border-input bg-ink-soft px-3 py-2 text-t6 text-cream hover:bg-surface cursor-pointer">
          <%= icon "external-link", class: "size-3.5" %>
          Pokaż na stronie
        </button>
      </div>

      <% section.fields.reject(&:admin_hidden?).each do |field| %>
        <% if field.image? %>
          <%= render "admin/content_blocks/image_input",
                     section: section, field: field, block: blocks[field.full_key] %>
        <% else %>
          <div class="flex flex-col gap-2 min-w-0">
            <div class="flex items-start justify-between gap-2">
              <span class="text-t6 uppercase text-tan"><%= field.label %></span>
              <details class="text-xs text-taupe-dark text-right">
                <summary title="Identyfikator pola" class="cursor-pointer list-none text-taupe hover:text-tan">
                  <%= icon "info", class: "size-4" %>
                  <span class="sr-only">Identyfikator pola</span>
                </summary>
                <code><%= field.full_key %></code>
              </details>
            </div>
            <% ContentBlock::LOCALES.each do |locale| %>
              <%= render "admin/content_blocks/field_input",
                         section: section, field: field, block: blocks[field.full_key],
                         locale: locale, editor_locale: editor_locale %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if section.collection? %>
        <%= render "admin/content_blocks/collection_fields",
                   collection: section.collection, items: items, editor_locale: editor_locale %>
      <% end %>
    </div>
  <% end %>

  <% if section.collection? %>
    <%# Outside the form: the POST link must not nest a second form. %>
    <div class="border-t border-border-strong px-4 py-4 sm:px-6">
      <%= link_to admin_content_items_path(collection_key: section.full_key, lang: (editor_locale == "en" ? "en" : nil)),
                  data: { turbo_method: :post },
                  class: "inline-flex items-center gap-1.5 rounded-lg border border-border-input bg-ink-soft px-3 py-2 text-t6 font-medium text-cream no-underline hover:bg-surface" do %>
        <%= icon "file-text", class: "size-3.5 shrink-0" %>
        Dodaj: <%= section.collection.item_label.downcase %>
      <% end %>
    </div>
  <% end %>
</div>
