<%#
  An image block: one upload, not a Polish/English pair.

  Posted under `images[...]` rather than `fields[...]` so the controller can tell
  a file apart from copy without inspecting the value.

  locals: section, field, block
%>
<%
  attached = block&.image&.attached?
  dom_id = "image-#{section.full_key.tr('.', '-')}-#{field.key}"
%>

<div class="flex flex-col gap-2">
  <div class="flex flex-wrap items-baseline gap-2">
    <span class="text-t6 uppercase text-taupe"><%= field.label %></span>
    <span class="text-t6 font-mono text-taupe-dark"><%= field.full_key %></span>
  </div>

  <div class="flex flex-wrap items-start gap-4">
    <% if attached %>
      <%# a thumbnail, so it is obvious which picture is about to be replaced %>
      <%= image_tag block.image.variant(resize_to_limit: [ 240, 240 ]),
                    class: "w-28 h-28 rounded-lg border border-border-strong object-cover" %>
    <% else %>
      <div class="w-28 h-28 rounded-lg border border-dashed border-border-strong flex items-center justify-center text-t6 text-taupe-dark text-center px-2">
        Brak zdjęcia
      </div>
    <% end %>

    <div class="flex flex-col gap-2 flex-1 min-w-60">
      <%= file_field_tag "images[#{field.key}][file]",
                         accept: ContentBlock::IMAGE_CONTENT_TYPES.join(","),
                         id: dom_id, class: "form-control py-1.5" %>

      <span class="text-t6 text-taupe-dark">
        PNG, JPG, WEBP lub AVIF, do <%= number_to_human_size(ContentBlock::IMAGE_MAX_BYTES) %>.
        Wgranie nowego pliku zastąpi obecne zdjęcie.
      </span>

      <% if attached %>
        <label class="flex items-center gap-2 text-t6 text-tan">
          <%= check_box_tag "images[#{field.key}][remove]", "1", false,
                            id: "#{dom_id}-remove",
                            class: "size-4 rounded border-border-input bg-surface accent-accent" %>
          Usuń zdjęcie przy zapisie
        </label>
      <% end %>
    </div>
  </div>
</div>
