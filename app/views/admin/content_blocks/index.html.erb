<% content_for :title, "Treści — Panel" %>

<div class="p-6 sm:p-8 flex flex-col gap-6"
     data-controller="content-blocks"
     <%= tag.attributes(
           "data-content-blocks-open-value" =>
             @open_section && "section-#{@open_section.page.key}-#{@open_section.key}"
         ) %>>
  <div class="flex flex-col gap-1">
    <h1 class="text-t2 font-display text-cream">Treści</h1>
    <p class="text-t5 text-taupe">
      Teksty na stronie. Pusta wersja angielska wyświetli polską. Każdą sekcję zapisujesz osobno.
    </p>
  </div>

  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <aside class="w-full lg:w-72 lg:shrink-0 lg:sticky lg:top-6">
      <%= render TreeView::Component.new(variant: :bordered) do |tree| %>
        <% @pages.each do |page| %>
          <% tree.with_node(label: page.label, type: :folder, default_open: true) do |page_node| %>
            <% page.sections.each do |section| %>
              <% page_node.with_child(label: section.label, type: :folder) do |section_node| %>
                <% section.fields.each do |field| %>
                  <% section_node.with_child(
                       label: field.label,
                       href: "#section-#{page.key}-#{section.key}"
                     ) %>
                <% end %>

                <%# a collection-only section would otherwise be an empty folder
                    with nothing in the tree pointing at its editor %>
                <% if section.collection? %>
                  <% section_node.with_child(
                       label: "Lista: #{section.collection.item_label.downcase}",
                       href: "#section-#{page.key}-#{section.key}"
                     ) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </aside>

    <div class="flex-1 min-w-0 w-full flex flex-col gap-8">
      <% @pages.each do |page| %>
        <section class="flex flex-col gap-3">
          <h2 class="text-t3 font-display text-cream"><%= page.label %></h2>

          <%# allow_multiple so comparing two sections does not close the first %>
          <%= render Accordion::Component.new(allow_multiple: true, variant: :bordered) do |accordion| %>
            <% page.sections.each do |section| %>
              <% accordion.with_item(title: section.label, default_open: section == @open_section) do %>
                <%= render "admin/content_blocks/section_form",
                           page: page, section: section, blocks: @blocks,
                           items: @items[section.full_key] || [] %>
              <% end %>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
</div>
