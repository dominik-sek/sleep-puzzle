<% content_for :title, "Treści - Panel" %>

<div class="p-4 sm:p-6 xl:p-8 flex flex-col gap-5"
     data-controller="content-blocks"
     data-content-blocks-section-value="<%= @open_section.full_key %>"
     data-content-blocks-page-value="<%= @preview_page %>"
     data-content-blocks-pages-value="<%= @preview_data.to_json %>"
     data-content-blocks-lang-value="<%= @editor_locale %>">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-t2 font-display text-cream">Treści</h1>
      <p class="text-t5 text-taupe mt-1">Wybierz stronę i sekcję, którą chcesz edytować.</p>
    </div>
    <button type="button" data-content-blocks-target="previewButton"
            data-action="click->content-blocks#togglePreview"
            aria-controls="content-preview" aria-expanded="false"
            class="inline-flex items-center gap-2 rounded-lg border border-border-input bg-surface px-4 py-2.5 text-t6 text-cream hover:bg-ink-soft cursor-pointer">
      <%= icon "external-link", class: "size-4" %>
      <span data-content-blocks-target="previewButtonLabel">Podgląd</span>
    </button>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-[14rem_minmax(0,1fr)] gap-5 items-start min-w-0">
    <aside class="rounded-xl border border-border-strong bg-ink-soft p-4 xl:sticky xl:top-6 xl:max-h-[calc(100vh-3rem)] xl:overflow-y-auto">
      <label for="content-search" class="block text-t6 text-tan mb-2">Znajdź treść</label>
      <input type="search" id="content-search" placeholder="Strona, sekcja lub pole"
             autocomplete="off" data-content-blocks-target="search"
             data-action="input->content-blocks#search"
             class="form-control w-full mb-4">

      <div data-content-blocks-target="navigation">
        <label for="content-page" class="block text-t6 text-tan mb-2">Strona</label>
        <select id="content-page" data-content-blocks-target="editorPage"
                data-action="change->content-blocks#changeEditorPage"
                class="form-control w-full mb-4">
          <% @pages.each do |page| %>
            <%= tag.option page.label, value: page.key, selected: page == @open_section.page %>
          <% end %>
        </select>

        <nav aria-label="Sekcje strony">
          <p class="text-t6 text-taupe mb-2">Sekcje</p>
          <div class="flex flex-col gap-1">
            <% @open_section.page.sections.reject(&:admin_hidden?).each do |section| %>
              <%= link_to admin_content_blocks_path(open: section.full_key, lang: (@editor_locale == "en" ? "en" : nil)),
                          class: "block rounded-lg px-3 py-2.5 text-sm no-underline #{section == @open_section ? 'bg-accent/15 text-accent ring-1 ring-accent/40 font-semibold' : 'text-tan hover:bg-surface hover:text-cream'}",
                          "aria-current": (section == @open_section ? "page" : nil) do %>
                <%= section.label %>
              <% end %>
            <% end %>
          </div>
        </nav>
      </div>

      <div data-content-blocks-target="results" hidden>
        <p data-content-blocks-target="resultCount" role="status" class="text-t6 text-taupe mb-2"></p>
        <nav aria-label="Wyniki wyszukiwania" class="flex flex-col gap-1">
          <% @pages.each do |page| %>
            <% page.sections.reject(&:admin_hidden?).each do |section| %>
              <% search_text = ([page.label, section.label] + section.fields.reject(&:admin_hidden?).map(&:label) + (section.collection&.fields&.map(&:label) || [])).join(" ") %>
              <%= link_to admin_content_blocks_path(open: section.full_key, lang: (@editor_locale == "en" ? "en" : nil)),
                          data: { content_blocks_target: "searchResult", search_text: search_text },
                          class: "block rounded-lg px-3 py-2.5 text-sm text-cream no-underline hover:bg-surface" do %>
                <span class="block text-xs text-taupe"><%= page.label %></span>
                <span><%= section.label %></span>
              <% end %>
            <% end %>
          <% end %>
        </nav>
        <p data-content-blocks-target="noResults" class="text-t6 text-taupe" hidden>Nie znaleziono takiej treści.</p>
      </div>
    </aside>

    <div class="cms-workspace grid grid-cols-1 gap-5 min-w-0 items-start"
         data-content-blocks-target="workspace" data-preview-open="false">
      <section class="cms-editor min-w-0 rounded-xl border border-border-strong bg-surface"
               aria-labelledby="content-section-title">
        <div class="px-4 pt-4 sm:px-6 sm:pt-6">
          <p class="text-t6 text-taupe"><%= @open_section.page.label %> / Sekcja</p>
          <h2 id="content-section-title" class="font-display text-t3 text-cream mt-1"><%= @open_section.label %></h2>
        </div>
        <%= render "admin/content_blocks/section_form",
                   page: @open_section.page, section: @open_section, blocks: @blocks,
                   items: @items[@open_section.full_key] || [], editor_locale: @editor_locale %>
      </section>

      <section id="content-preview" data-content-blocks-target="preview" hidden
               class="min-w-0 rounded-xl border border-border-strong bg-ink-soft p-4 sm:p-5 flex flex-col gap-4 lg:sticky lg:top-6 lg:h-[calc(100vh-3rem)] lg:max-h-[950px]">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-t4 font-display text-cream">Podgląd strony</h2>
            <p class="text-t6 text-taupe mt-1">Tekst zmienia się podczas pisania. Zdjęcia, listy i formatowanie zobaczysz po zapisie.</p>
          </div>
          <button type="button" data-action="click->content-blocks#togglePreview"
                  aria-label="Zamknij podgląd" class="shrink-0 rounded-lg p-2 text-taupe hover:text-cream hover:bg-surface cursor-pointer">
            <%= icon "x", class: "size-4" %>
          </button>
        </div>
        <div class="flex flex-wrap gap-3">
          <label class="flex-1 min-w-36 text-t6 text-taupe">
            Strona
            <select data-content-blocks-target="pageSelect" data-action="change->content-blocks#changePage" class="form-control mt-1">
              <% @pages.each do |page| %>
                <%= tag.option page.label, value: page.key, selected: page.key == @preview_page %>
              <% end %>
            </select>
          </label>
          <label class="min-w-28 text-t6 text-taupe">
            Język
            <select data-content-blocks-target="localeSelect" data-action="change->content-blocks#changeLocale" class="form-control mt-1">
              <option value="pl" <%= "selected" if @editor_locale == "pl" %>>Polski</option>
              <option value="en" <%= "selected" if @editor_locale == "en" %>>English</option>
            </select>
          </label>
        </div>
        <p data-content-blocks-target="status" role="status" class="text-t6 text-taupe m-0">
          Wybierz „Pokaż na stronie”, aby zaznaczyć miejsce sekcji.
        </p>
        <div class="h-[min(65vh,650px)] lg:h-auto lg:flex-1 lg:min-h-0 overflow-hidden rounded-lg border border-border-strong bg-ink">
          <iframe data-content-blocks-target="frame"
                  title="Podgląd strony" sandbox="allow-same-origin"
                  class="w-full h-full border-0"></iframe>
        </div>
      </section>
    </div>
  </div>
</div>
