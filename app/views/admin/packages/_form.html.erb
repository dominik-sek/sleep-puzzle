<%= form_with model: [ :admin, package ], scope: :record, class: "flex flex-col gap-6",
              data: { controller: "package-copy", action: "input->package-copy#refresh",
                      package_copy_summary_limit_value: Package::CARD_SUMMARY_MAX_LENGTH,
                      package_copy_highlights_limit_value: Package::CARD_HIGHLIGHTS_LIMIT,
                      package_copy_highlight_length_value: Package::CARD_HIGHLIGHT_MAX_LENGTH } do %>
  <%= render "admin/shared/form_errors", record: package %>

  <%= render "admin/shared/translated_input", record: package, field: "name",
             label: "Nazwa", type: :text %>

  <fieldset class="flex flex-col gap-5 border-t border-border-strong pt-5">
    <legend class="font-display text-t3 text-cream">Na karcie</legend>
    <p class="text-t6 text-tan">Krótki opis i różnice między pakietami. Instrukcje oraz warunki wpisz w pełnych szczegółach poniżej.</p>
    <%= render "admin/shared/translated_input", record: package, field: "for_whom",
               label: "Dla kogo", type: :textarea, copy_kind: "summary",
               hint: "Jedno zdanie, do #{Package::CARD_SUMMARY_MAX_LENGTH} znaków. Dłuższy opis będzie widoczny w szczegółach." %>
    <%= render "admin/shared/translated_input", record: package, field: "highlights",
               label: "W skrócie", type: :list, copy_kind: "highlights",
               hint: "Do 5 wyróżników, jeden w linii, do 140 znaków każdy. Dalsze pozycje pojawią się w szczegółach." %>
  </fieldset>

  <fieldset class="flex flex-col gap-5 border-t border-border-strong pt-5">
    <legend class="font-display text-t3 text-cream">Pełne szczegóły</legend>
    <%= render "admin/shared/translated_input", record: package, field: "core",
               label: "Co otrzymujecie", type: :list, hint: "Jedno świadczenie w linii, razem z jego warunkami i terminem wykorzystania." %>
    <%= render "admin/shared/translated_input", record: package, field: "extra",
               label: "Dodatkowo", type: :list, hint: "Jedna pozycja w linii, razem z warunkami." %>
    <%= render "admin/shared/translated_input", record: package, field: "organization",
               label: "Przygotowanie i kontakt", type: :textarea,
               hint: "Oddziel akapity pustą linią. Podaj wymagane dokumenty, terminy, komunikator i godziny odpowiedzi." %>
    <p class="text-t6 text-tan">Informacje identyczne we wszystkich pakietach edytuj w Treści → Pakiety → Wspólne zasady współpracy.</p>
  </fieldset>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="flex flex-col gap-1.5">
      <span class="text-t6 uppercase text-taupe">Czas trwania (tygodnie)</span>
      <%# not translated: a number reads the same in both languages %>
      <%= number_field_tag "record[duration]", package.duration, id: "record-duration", min: 1,
                           class: "form-control" %>
    </div>

    <%= render "admin/shared/price_field", record: package, prices: prices %>
  </div>

  <%= render "admin/shared/publication_fields", record: package %>

  <div class="flex items-center gap-3">
    <%= submit_tag package.persisted? ? "Zapisz pakiet" : "Dodaj pakiet",
                   class: "inline-flex items-center justify-center rounded-lg border border-accent-terracotta/30 bg-accent px-3.5 py-2 text-sm font-medium text-ink shadow-sm cursor-pointer hover:bg-accent-hover" %>

    <%= link_to "Anuluj", admin_packages_path,
                class: "text-t6 text-taupe no-underline hover:text-cream" %>
  </div>
<% end %>
