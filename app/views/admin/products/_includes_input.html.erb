<div class="flex flex-col gap-2">
  <span class="text-t6 uppercase text-taupe">Co obejmuje / Co dostajesz</span>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <% Translatable::LOCALES.each do |locale| %>
      <div class="flex flex-col gap-1.5">
        <label for="record-includes-<%= locale %>" class="text-t6 text-taupe"><span class="sr-only">Co obejmuje / Co dostajesz — </span><%= locale == :pl ? "Polski" : "English" %></label>
        <%= rich_text_area_tag "record[includes_rich][#{locale}]", product.includes_editor_html(locale),
                               id: "record-includes-#{locale}" %>
      </div>
    <% end %>
  </div>
</div>
