<%# multipart because the audio file is uploaded through this form; form_with only
    infers that from a builder-based file field, and this form uses tag helpers %>
<%= turbo_stream_from Product::ADMIN_STREAM %>

<%# on the form rather than the field: the progress bar holds the submit button,
    and direct-upload events bubble up here from the input %>
<% upload_data =
     if BunnyStorageService.configured?
       { controller: "audio-upload",
         audio_upload_max_bytes_value: BunnyStorageService::MAX_BYTES,
         audio_upload_extensions_value: BunnyStorageService::ALLOWED_EXTENSIONS.to_json,
         action: "direct-upload:start->audio-upload#start " \
                 "direct-upload:progress->audio-upload#progress " \
                 "direct-upload:error->audio-upload#error " \
                 "direct-upload:end->audio-upload#end" }
     else
       {}
     end %>

<%= form_with model: [ :admin, product ], scope: :record, multipart: true,
              data: upload_data, class: "flex flex-col gap-6" do %>
  <%= render "admin/shared/form_errors", record: product %>

  <%= render "admin/shared/translated_input", record: product, field: "name",
             label: "Nazwa", type: :text %>

  <%= render "admin/shared/translated_input", record: product, field: "description",
             label: "Opis", type: :textarea %>

  <%= render "admin/shared/translated_input", record: product, field: "long_description",
             label: "O tym nagraniu", type: :textarea,
             hint: "dłuższy opis na stronie produktu" %>

  <%= render "admin/shared/translated_input", record: product, field: "includes",
             label: "Co dostajesz", type: :list %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="flex flex-col gap-1.5">
      <span class="text-t6 uppercase text-taupe">Rodzaj</span>
      <%= select_tag "record[kind]",
                     options_for_select(Product.kind_options, product.kind),
                     include_blank: "— wybierz rodzaj —",
                     id: "record-kind", class: "form-control" %>
    </div>

    <div class="flex flex-col gap-1.5">
      <span class="text-t6 uppercase text-taupe">Ikona</span>
      <%# one emoji, shown on the shop card and in the cart. Blank falls back to
          one per rodzaj, so this can be left alone. %>
      <%= text_field_tag "record[icon]", product.icon, id: "record-icon",
                         placeholder: Product::KIND_ICONS.values.join(" "),
                         maxlength: 8, class: "form-control" %>
    </div>

    <div class="flex flex-col gap-1.5">
      <span class="text-t6 uppercase text-taupe">Długość (min)</span>
      <%= number_field_tag "record[length_minutes]", product.length_minutes, id: "record-length-minutes",
                           min: 1, class: "form-control" %>
    </div>

    <%= render "admin/shared/price_field", record: product, prices: prices %>
  </div>

  <div class="flex flex-col gap-1.5">
    <span class="text-t6 uppercase text-taupe">Plik audio (Bunny)</span>

    <%= render "admin/products/audio_status", product: product %>

    <% if BunnyStorageService.configured? %>
      <%# direct_upload_url is what makes @rails/activestorage take the file before
          the form is submitted, which is where the percentage comes from %>
      <%= file_field_tag "record[audio]", accept: "audio/*", id: "record-audio",
                         data: { direct_upload_url: rails_direct_uploads_path,
                                 audio_upload_target: "input",
                                 action: "change->audio-upload#validate" },
                         class: "form-control file:mr-3 file:rounded-md file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-sm file:text-cream file:cursor-pointer" %>

      <div data-audio-upload-target="progress" class="hidden flex-col gap-1.5">
        <div class="flex items-baseline justify-between gap-3 text-t6">
          <span data-audio-upload-target="label" class="truncate text-tan"></span>
          <span data-audio-upload-target="percent" class="tabular-nums text-cream">0%</span>
        </div>

        <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10">
          <div data-audio-upload-target="bar"
               class="h-full w-0 rounded-full bg-accent transition-[width] duration-150 ease-out"></div>
        </div>
      </div>

      <p data-audio-upload-target="error" class="hidden text-t6 text-orange-400 m-0"></p>

      <span class="text-t6 text-taupe">
        <%= product.cdn_path.present? ? "Wgranie nowego pliku zastąpi obecny." : "Wgraj nagranie — trafi prosto do Bunny Storage." %>
        Formaty: <%= BunnyStorageService::ALLOWED_EXTENSIONS.join(", ") %>, do
        <%= BunnyStorageService::MAX_BYTES / 1.megabyte %> MB.
      </span>
    <% else %>
      <%# no storage credentials — local development, or a deploy that lost them.
          The path stays typeable so the field is not simply dead, and the reason
          the uploader is missing is on the screen rather than in a log. %>
      <%= text_field_tag "record[cdn_path]", product.cdn_path, id: "record-cdn-path",
                         placeholder: "/bajki/o-sowie.mp3", class: "form-control" %>
      <span class="text-t6 text-taupe">
        Wgrywanie plików jest wyłączone — brakuje BUNNY_STORAGE_ZONE i
        BUNNY_STORAGE_PASSWORD. Na razie można wpisać ścieżkę pliku w Bunny Storage ręcznie.
      </span>
    <% end %>
  </div>

  <%= render "admin/shared/publication_fields", record: product %>

  <div class="flex items-center gap-3">
    <%= submit_tag product.persisted? ? "Zapisz produkt" : "Dodaj produkt",
                   data: { audio_upload_target: "submit" },
                   class: "inline-flex items-center justify-center rounded-lg border border-accent-terracotta/30 bg-accent px-3.5 py-2 text-sm font-medium text-ink shadow-sm cursor-pointer hover:bg-accent-hover" %>

    <%= link_to "Anuluj", admin_products_path,
                class: "text-t6 text-taupe no-underline hover:text-cream" %>
  </div>
<% end %>
