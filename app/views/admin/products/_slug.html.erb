<% current_path = product.kind_in_database == "audio_process" ? audio_process_path(slug: product.slug_in_database, locale: nil) : story_path(slug: product.slug_in_database, locale: nil) %>
<% pending = product.regenerate_slug? && product.slug_preview.present? && product.slug_preview == product.suggested_slug %>
<% pending_path = product.audio_process? ? audio_process_path(slug: product.slug_preview, locale: nil) : story_path(slug: product.slug_preview, locale: nil) if pending %>
<section aria-labelledby="product-url-heading" class="flex min-w-0 flex-col gap-3"
         data-controller="product-slug" data-product-slug-url-value="<%= slug_preview_admin_product_path(product) %>"
         data-product-slug-current-slug-value="<%= product.slug_in_database %>">
  <h2 id="product-url-heading" class="m-0 text-t5 font-bold text-cream">Adres produktu</h2>
  <p class="m-0 text-t6 text-tan [overflow-wrap:anywhere]"><%= current_path %></p>
  <p class="m-0 max-w-[65ch] text-t6 text-tan">Zmiana nazwy zachowuje obecny adres. Możesz wygenerować nowy adres i zapisać go razem z produktem. Poprzednie adresy będą przekierowywać do aktualnego.</p>

  <%= hidden_field_tag "record[regenerate_slug]", pending ? "1" : "0", data: { product_slug_target: "regenerate" } %>
  <%= hidden_field_tag "record[slug_preview]", pending ? product.slug_preview : "", data: { product_slug_target: "expected" } %>

  <div data-product-slug-target="pending" <%= "hidden" unless pending %>>
    <p class="m-0 text-t6 text-tan">Adres po zapisaniu:</p>
    <output data-product-slug-target="path" class="block text-t5 text-cream [overflow-wrap:anywhere]"><%= pending_path %></output>
  </div>
  <div class="flex flex-wrap gap-x-4 gap-y-2" data-product-slug-target="controls" hidden>
    <button type="button" data-product-slug-target="generate" data-action="product-slug#generate"
            class="min-h-11 cursor-pointer rounded-md border border-border-input bg-transparent px-3 py-2 text-t6 font-bold text-accent hover:text-accent-hover disabled:cursor-wait disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Wygeneruj adres z nazwy</button>
    <button type="button" data-product-slug-target="reset" data-action="product-slug#reset" <%= "hidden" unless pending %>
            class="min-h-11 cursor-pointer rounded-md border-0 bg-transparent px-3 py-2 text-t6 text-tan hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Zachowaj obecny adres</button>
  </div>
  <p role="status" aria-live="polite" data-product-slug-target="status" class="m-0 text-t6 text-tan"><%= "Podgląd gotowy. Zapisz produkt, aby zmienić adres." if pending %></p>
  <noscript><p class="m-0 text-t6 text-tan">Generowanie nowego adresu wymaga JavaScript. Możesz zapisać produkt z obecnym adresem.</p></noscript>
</section>
