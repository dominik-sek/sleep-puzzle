<div class="flex flex-col gap-2 rounded-2xl border border-border-strong bg-surface p-4">
  <div class="flex min-w-0 items-start gap-2 text-taupe">
    <%= icon icon_name, class: "size-4 shrink-0" %>
    <span class="min-w-0 text-t6 uppercase [overflow-wrap:anywhere]"><%= label %></span>
  </div>
  <span class="text-t2 font-display text-cream tabular-nums"><%= value %></span>
  <span class="text-t6 font-medium text-taupe"><%= hint %></span>
</div>
