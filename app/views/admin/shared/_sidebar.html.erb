<aside class="bg-surface-dark border-b border-border-strong md:border-b-0 md:border-r md:w-60 md:shrink-0">
  <div class="md:sticky md:top-0 md:h-screen flex flex-col gap-6 p-4">
    <a href="<%= admin_root_path %>" class="flex items-center gap-2 px-2 pt-1 no-underline">
      <span class="font-display text-t3 text-cream">sleep.puzzle</span>
      <span class="text-t6 uppercase text-accent tracking-wide">panel</span>
    </a>

    <%# horizontally scrollable row on mobile, stacked column from md up %>
    <nav class="flex md:flex-col gap-1 overflow-x-auto md:overflow-visible">
      <%= admin_nav_link "Pulpit", admin_root_path, "layout-dashboard" %>
      <%= admin_nav_link "Rezerwacje", admin_bookings_path, "calendar-days",
            active: controller_name == "bookings" %>
    </nav>

    <div class="md:mt-auto flex md:flex-col gap-1 border-t border-border pt-3">
      <%= admin_nav_link "Wróć na stronę", root_path, "external-link" %>

      <%= button_to destroy_user_session_path, method: :delete,
            class: "flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-taupe no-underline bg-transparent border-0 w-full text-left cursor-pointer hover:bg-ink-soft hover:text-cream" do %>
        <%= icon "log-out", class: "size-4 shrink-0" %>
        <span class="whitespace-nowrap">Wyloguj się</span>
      <% end %>
    </div>
  </div>
</aside>
