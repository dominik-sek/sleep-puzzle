<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>

  <%# table layout and inline styles throughout: Outlook and Gmail strip <style> blocks %>
  <body style="margin:0; padding:0; background-color:#f5f0e8; font-family:Helvetica,Arial,sans-serif; color:#211e1c;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f0e8; padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:12px; overflow:hidden;">
            <tr>
              <td style="background-color:#211e1c; padding:20px 28px;">
                <span style="color:#f5f0e8; font-size:18px; letter-spacing:0.5px;">sleep.puzzle</span>
              </td>
            </tr>
            <tr>
              <td style="padding:28px;">
                <%= yield %>
              </td>
            </tr>
          </table>

          <p style="max-width:560px; margin:16px auto 0; color:#8a8279; font-size:12px; line-height:18px;">
            © <%= Date.current.year %> Sleep Puzzle
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
