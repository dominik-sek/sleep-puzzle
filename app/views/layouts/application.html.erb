<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Sleep Puzzle" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sleep Puzzle">
    <meta name="mobile-web-app-capable" content="yes">
    <%# tells search engines the two addresses are the same page in two languages,
        which is the whole reason the locale is in the path rather than the session %>
    <% I18n.available_locales.each do |locale| %>
      <%= tag.link rel: "alternate", hreflang: locale, href: alternate_locale_url(locale) %>
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'application', data: { "turbo-track": "reload" } %>
    <%= vite_javascript_tag 'application' %>

  </head>

  <%# the language is carried on the body, not read back off <html>: Turbo Drive
      replaces the body and merges the head but leaves the <html> element's own
      attributes alone, so lang= goes stale the moment you switch language. See
      locale_controller.js, which copies it back up. %>
  <body class="relative min-h-screen flex flex-col" data-controller="locale" data-locale-tag-value="<%= I18n.locale %>">
  <%= render "shared/navbar" %>

  <%= render Toast::Component.new(
    position: "top-right",
    layout: "default",
    auto_dismiss_duration: 5000,
    limit: 4,
    gap: 16,
  ) %>

  <%= render "shared/flash" %>


    <main class="flex-1 flex flex-col">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
