<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Panel — Sleep Puzzle" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# the panel is staff-only and not linked from anywhere public %>
    <meta name="robots" content="noindex, nofollow">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'application', data: { "turbo-track": "reload" } %>
    <%= vite_javascript_tag 'application' %>
  </head>

  <%# no Paddle script, public navbar or footer here: nothing in the panel checks out %>
  <%# h-screen + overflow-hidden: the sidebar shell is built from h-full and
      inner overflow-y-auto regions, which only work against a bounded height.
      Without it the whole document scrolls and the sidebar scrolls away. %>
  <body class="h-screen overflow-hidden bg-ink text-cream">
    <%= render Toast::Component.new(
      position: "top-right",
      layout: "default",
      auto_dismiss_duration: 5000,
      limit: 4,
      gap: 16,
    ) %>

    <%= render "shared/flash" %>

    <%# captured before the component block: Sidebar::Component renders the <main>
        itself and takes the page as its content %>
    <% page_body = yield %>

    <%= render Sidebar::Component.new(storage_key: "adminSidebarOpen", min_height_class: "h-full") do |sidebar| %>
      <% sidebar.with_logo do %>
        <a href="<%= admin_root_path %>" class="flex items-center gap-2 px-2 no-underline">
          <span class="font-display text-t3 text-cream">sleep.puzzle</span>
          <span class="text-t6 uppercase text-accent tracking-wide">panel</span>
        </a>
      <% end %>

      <% admin_sidebar_items.each do |item| %>
        <% sidebar.with_item(
             label: item[:label],
             href: item[:href],
             icon: icon(item[:icon], class: "size-4 shrink-0"),
             active: item[:active]
           ) %>
      <% end %>

      <% sidebar.with_footer do %>
        <div class="flex flex-col gap-1 border-t border-border pt-2">
          <a href="<%= root_path %>" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-taupe no-underline hover:bg-ink-soft hover:text-cream">
            <%= icon "external-link", class: "size-4 shrink-0" %>
            <span>Wróć na stronę</span>
          </a>

          <%= button_to destroy_user_session_path, method: :delete,
                class: "flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-sm text-taupe bg-transparent border-0 text-left cursor-pointer hover:bg-ink-soft hover:text-cream" do %>
            <%= icon "log-out", class: "size-4 shrink-0" %>
            <span>Wyloguj się</span>
          <% end %>
        </div>
      <% end %>

      <%# icon-only versions for the collapsed rail %>
      <% sidebar.with_collapsed_footer do %>
        <div class="flex flex-col items-center gap-1">
          <a href="<%= root_path %>" aria-label="Wróć na stronę"
             class="flex size-8 items-center justify-center rounded-lg text-taupe hover:bg-ink-soft hover:text-cream">
            <%= icon "external-link", class: "size-4 shrink-0" %>
          </a>

          <%= button_to destroy_user_session_path, method: :delete,
                "aria-label": "Wyloguj się",
                class: "flex size-8 items-center justify-center rounded-lg text-taupe bg-transparent border-0 cursor-pointer hover:bg-ink-soft hover:text-cream" do %>
            <%= icon "log-out", class: "size-4 shrink-0" %>
          <% end %>
        </div>
      <% end %>

      <%= page_body %>
    <% end %>
  </body>
</html>
