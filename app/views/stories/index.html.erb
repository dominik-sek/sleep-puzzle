<% content_for :title, page_title(content_block("stories.hero.title")) %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(background: :ink, align: :left) do %>
    <div class="mx-auto w-full max-w-[1080px]">
      <h1 class="font-display text-t1 font-bold text-cream text-pretty [overflow-wrap:anywhere]"><%= content_block("stories.hero.title") %></h1>
      <p class="mt-3 max-w-[70ch] text-t5 text-tan [overflow-wrap:anywhere]"><%= content_block("stories.hero.intro") %></p>

      <% if @products.any? %>
        <div class="mt-6">
          <%= render "products/grid", products: @products, samples: true %>
        </div>
        <p id="audio-delivery-label" class="mt-8 text-t6 font-bold text-cream"><%= t("products.audio_delivery") %></p>
        <dl aria-labelledby="audio-delivery-label" class="mt-3 grid max-w-xl gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))]">
          <%= render "products/delivery_specs" %>
        </dl>
      <% else %>
        <p class="mt-6 text-t5 text-tan [overflow-wrap:anywhere]"><%= content_block("stories.hero.empty") %></p>
      <% end %>

      <%= link_to t("nav.shop"), products_path,
                  class: "mt-6 inline-flex min-h-11 items-center rounded-md py-2 text-t6 font-bold text-tan no-underline hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
    </div>
  <% end %>
</div>
