<div class="min-h-screen flex flex-col items-center justify-center">
  <%= render Section::Component.new(
    title: "Układamy sen Twojej rodziny jak puzzle.",
    subtitle: "Kawałek po kawałku pomagam odzyskać spokojne noce, równowagę i czas dla siebie, partnera i dziecka - z empatią, wiedzą i bez presji.",
    align: :left,
    background: :ink,
    bordered: false,
  ) do |section| %>

    <div>
      sleep puzzle logo placeholder
    </div>

    <% section.with_actions do %>
        <div class="flex gap-4">
          <%= render Buttons::Component.new(
            text: "Umów konsultację",
            pill: true,
            variant: :primary,
            classes: "hover:cursor-pointer bg-accent! text-t6! py-3 px-6 font-bold!"
          ) %>

          <%= render Buttons::Component.new(
            text: "Zobacz pakiety",
            pill: true,
            variant: :secondary,
            classes: "hover:cursor-pointer text-t6! py-3 px-6 font-semibold!"
          ) %>

        </div>
    <% end %>

  <% end %>

  <%= render Section::Component.new(
    background: :ink_soft,
    align: :center,
    bordered: false,
    ) do |section| %>
    cool stuff here
  <% end %>

  <div class="max-w-xl text-center">
    <div class="inline-block bg-surface border border-border-input text-accent text-t6 px-4 py-2 rounded-full mb-6">
      Design system
    </div>
    <h1 class="font-display text-t1 text-cream mb-4">
      sleep.puzzle
    </h1>
    <p class="font-display text-t3 text-accent mb-2">
      Section title (t3)
    </p>
    <p class="text-tan text-t4 mb-4">
      Lead paragraph (t4) — Quicksand for body copy, Baloo 2 for display type, on a warm dark palette with an amber accent.
    </p>
    <p class="text-tan text-t5 mb-8">
      Body copy (t5) sample text.
    </p>
    <div class="flex gap-4 justify-center flex-wrap mb-8">
      <span class="bg-accent text-ink font-bold px-7 py-4 rounded-full">Primary action</span>
      <span class="border border-border-input text-cream font-bold px-7 py-4 rounded-full">Secondary action</span>
    </div>

    <div class="flex flex-col gap-4 text-left">
      <%= render Alert::Component.new(title: "Saved", tone: :success) do %>
        Your settings were updated.
      <% end %>
      <%= render Alert::Component.new(title: "Heads up", tone: :warning) do %>
        Check your booking details before confirming.
      <% end %>
    </div>

    <div data-controller="hello" class="mt-8 text-t6 text-taupe">
      <span data-hello-target="output">Stimulus not connected</span>
    </div>
  </div>
</div>
