<div class="min-h-screen flex items-center justify-center px-6">
  <div class="max-w-xl text-center">
    <div class="inline-block bg-surface border border-border-input text-accent text-t6 px-4 py-2 rounded-full mb-6">
      Design system
    </div>
    <h1 class="font-display text-t1 text-cream mb-4">
      sleep.puzzle
    </h1>
    <p class="font-display text-t3 text-accent mb-2">
      Section title (t3)
    </p>
    <p class="text-tan text-t4 mb-4">
      Lead paragraph (t4) — Quicksand for body copy, Baloo 2 for display type, on a warm dark palette with an amber accent.
    </p>
    <p class="text-tan text-t5 mb-8">
      Body copy (t5) sample text.
    </p>
    <div class="flex gap-4 justify-center flex-wrap mb-8">
      <span class="bg-accent text-ink font-bold px-7 py-4 rounded-full">Primary action</span>
      <span class="border border-border-input text-cream font-bold px-7 py-4 rounded-full">Secondary action</span>
    </div>

    <div class="flex flex-col gap-4 text-left">
      <%= render Alert::Component.new(title: "Saved", tone: :success) do %>
        Your settings were updated.
      <% end %>
      <%= render Alert::Component.new(title: "Heads up", tone: :warning) do %>
        Check your booking details before confirming.
      <% end %>
    </div>
  </div>
</div>
