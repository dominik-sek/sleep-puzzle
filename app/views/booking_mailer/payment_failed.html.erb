<h1 style="margin:0 0 12px; font-size:22px; line-height:30px; color:#211e1c;">
  <%= t("booking_mailer.payment_failed.heading") %>
</h1>

<p style="margin:0; font-size:15px; line-height:24px; color:#57514a;">
  <%= t("booking_mailer.payment_failed.intro") %>
</p>

<%= render "details", rows: {
      t("booking_mailer.details.package") => @booking.package.name,
      t("booking_mailer.details.starts_at") => l(@booking.starts_at, format: :long),
      t("booking_mailer.details.status") => Booking::PAYMENT_STATUS_LABELS.fetch(@booking.status)
    } %>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin:4px 0 0;">
  <tr>
    <td style="background-color:#e2933e; border-radius:8px;">
      <a href="<%= bookings_url %>"
         style="display:inline-block; padding:12px 22px; font-size:15px; color:#211e1c; text-decoration:none;">
        <%= t("booking_mailer.payment_failed.cta") %>
      </a>
    </td>
  </tr>
</table>
