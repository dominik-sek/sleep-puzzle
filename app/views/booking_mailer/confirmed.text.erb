<%= t("booking_mailer.confirmed.heading") %>

<%= t("booking_mailer.confirmed.intro") %>

<%= render "details", rows: {
      t("booking_mailer.details.package") => @booking.package.name,
      t("booking_mailer.details.starts_at") => l(@booking.starts_at, format: :long),
      t("booking_mailer.details.status") => Booking::PAYMENT_STATUS_LABELS.fetch(@booking.status)
    } -%>

<%= t("booking_mailer.confirmed.cta") %>: <%= booking_url(@booking) %>

<%= t("booking_mailer.confirmed.outro") %>
