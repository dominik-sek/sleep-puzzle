<% content_for :title, page_title(content_block("audio_landing.hero.title")) %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(background: :ink, align: :left) do %>
    <div class="mx-auto w-full max-w-[1080px]">
      <h1 class="page-title"><%= content_block("audio_landing.hero.title") %></h1>
      <div class="page-subtitle mt-3 max-w-[70ch]"><%= content_block("audio_landing.hero.intro") %></div>

      <% if @products.any? %>
        <div class="mt-8">
          <%= render "products/grid", products: @products %>
        </div>
      <% else %>
        <p class="mt-8 text-t5 text-tan"><%= content_block("audio_landing.hero.empty") %></p>
      <% end %>

      <%= link_to t("nav.shop"), products_path,
                  class: "mt-6 inline-flex min-h-11 min-w-11 items-center rounded-md py-2 text-t5 font-bold text-accent no-underline hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
    </div>
  <% end %>

  <%= render "shared/testimonials", background: :ink_soft %>
</div>
