<% content_for :title, t("auth.reset.title") %>

<%= render "devise/shared/card", title: t("auth.reset.title") do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <%= render "devise/shared/field", form: f, name: :password, label: t("auth.fields.new_password"), type: :password,
               hint: (@minimum_password_length && t("auth.sign_up.password_hint", count: @minimum_password_length)),
               options: { autofocus: true, autocomplete: "new-password", required: true } %>

    <%= render "devise/shared/field", form: f, name: :password_confirmation,
               label: t("auth.fields.password_confirmation"), type: :password,
               options: { autocomplete: "new-password", required: true } %>

    <%= render Buttons::Component.new(
      text: t("auth.reset.submit"), pill: true, full_width: true, variant: :primary, type: :submit,
      classes: "hover:cursor-pointer bg-accent! text-t6! py-3 px-6 font-bold! justify-center"
    ) %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
