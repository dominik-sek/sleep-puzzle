<% content_for :title, t("auth.forgot.title") %>

<%= render "devise/shared/card", title: t("auth.forgot.title"), subtitle: t("auth.forgot.intro") do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :post, class: "flex flex-col gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/field", form: f, name: :email, label: t("auth.fields.email"), type: :email,
               options: { autofocus: true, autocomplete: "email", required: true } %>

    <%= render Buttons::Component.new(
      text: t("auth.forgot.submit"), pill: true, full_width: true, variant: :primary, type: :submit,
      classes: "hover:cursor-pointer bg-accent! text-t6! py-3 px-6 font-bold! justify-center"
    ) %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
