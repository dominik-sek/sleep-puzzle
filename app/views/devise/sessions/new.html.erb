<% content_for :title, t("auth.sign_in.title") %>

<%= render "devise/shared/card", title: t("auth.sign_in.title") do %>
  <%= render "devise/shared/omniauth" %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name),
               html: { class: "flex flex-col gap-5" }) do |f| %>
    <%= render "devise/shared/field", form: f, name: :email, label: t("auth.fields.email"), type: :email,
               options: { autofocus: true, autocomplete: "email", required: true } %>

    <%= render "devise/shared/field", form: f, name: :password, label: t("auth.fields.password"), type: :password,
               options: { autocomplete: "current-password", required: true } %>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2.5 text-t6 text-tan">
        <%= f.check_box :remember_me, class: "size-4 rounded-sm border-border-input bg-ink-soft" %>
        <%= t("activerecord.attributes.user.remember_me", default: "Nie wylogowuj mnie") %>
      </label>
    <% end %>

    <%= render Buttons::Component.new(
      text: t("auth.sign_in.submit"), pill: true, full_width: true, variant: :primary, type: :submit,
      classes: "hover:cursor-pointer bg-accent! text-t6! py-3 px-6 font-bold! justify-center"
    ) %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
