<% content_for :title, t("auth.edit.title") %>

<%= render "devise/shared/card", title: t("auth.edit.title"), subtitle: t("auth.edit.intro") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/field", form: f, name: :email, label: t("auth.fields.email"), type: :email,
               options: { autocomplete: "email", required: true } %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-t6 text-taupe m-0">
        <%= t("devise.registrations.update_needs_confirmation") %>
        <span class="text-cream"><%= resource.unconfirmed_email %></span>
      </p>
    <% end %>

    <%# a Google sign-up has no password yet, so this reads as setting a first one
        rather than replacing an existing one %>
    <% setting_first_password = !resource.password_set? %>

    <% if setting_first_password %>
      <p class="text-t6 text-taupe m-0"><%= t("auth.set_password.hint") %></p>
    <% end %>

    <%= render "devise/shared/field", form: f, name: :password,
               label: setting_first_password ? t("auth.set_password.title") : t("auth.fields.new_password"),
               type: :password,
               hint: (@minimum_password_length && t("auth.sign_up.password_hint", count: @minimum_password_length)),
               options: { autocomplete: "new-password" } %>

    <%= render "devise/shared/field", form: f, name: :password_confirmation,
               label: t("auth.fields.password_confirmation"), type: :password,
               options: { autocomplete: "new-password" } %>

    <%# left out entirely when there is no password to confirm — asking for one the
        holder cannot know is what blocked every change a Google user tried to make %>
    <% unless setting_first_password %>
      <%= render "devise/shared/field", form: f, name: :current_password, label: t("auth.fields.current_password"),
                 type: :password, hint: t("auth.edit.current_password_hint"),
                 options: { autocomplete: "current-password", required: true } %>
    <% end %>

    <%= render Buttons::Component.new(
      text: t("auth.edit.submit"), pill: true, full_width: true, variant: :primary, type: :submit,
      classes: "hover:cursor-pointer bg-accent! text-t6! py-3 px-6 font-bold! justify-center"
    ) %>
  <% end %>

  <div class="text-center">
    <%= link_to t("auth.edit.back"), dashboard_index_path, class: "text-t6 text-taupe no-underline hover:text-accent" %>
  </div>

  <%# fenced off and last, in the app's alert colours: it is the one control here
      that cannot be undone %>
  <div class="rounded-xl border border-red-500/30 bg-red-500/5 p-4.5">
    <h2 class="text-t6 font-bold text-red-300 m-0"><%= t("auth.edit.danger_title") %></h2>
    <p class="mt-1.5 text-t6 text-tan m-0"><%= t("auth.edit.danger_body") %></p>

    <%= button_to t("auth.edit.destroy"), registration_path(resource_name), method: :delete,
          form_class: "contents",
          data: { turbo_confirm: t("auth.edit.destroy_confirm") },
          class: "mt-3.5 cursor-pointer rounded-full border border-red-500/40 bg-transparent px-4 py-2 text-t6 font-bold text-red-300 hover:bg-red-500/15" %>
  </div>
<% end %>
