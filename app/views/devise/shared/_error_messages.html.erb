<%#
  Validation errors on an auth form, in the app's own alert colours rather than the
  generator's bare <ul>. The heading comes from errors.messages.not_saved, which
  devise.pl.yml now translates.

  data-turbo-temporary: the panel must not survive into the page Turbo caches, or
  it reappears on the way back.

  locals: resource
%>
<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-temporary
       class="rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3">
    <p class="text-t6 font-bold text-red-300 m-0">
      <%= t("errors.messages.not_saved", count: resource.errors.count,
                                        resource: resource.class.model_name.human.downcase) %>
    </p>

    <ul class="mt-1.5 flex flex-col gap-1 list-disc pl-4 m-0">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-t6 text-red-200"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
