<h1 style="margin:0 0 12px; font-size:22px; line-height:30px; color:#211e1c;">
  <%= t("auth.mailer.reset_password.heading") %>
</h1>

<p style="margin:0 0 16px; font-size:15px; line-height:24px; color:#57514a;">
  <%= t("auth.mailer.reset_password.intro", email: @resource.email) %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin:4px 0 20px;">
  <tr>
    <td style="background-color:#e2933e; border-radius:8px;">
      <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>"
         style="display:inline-block; padding:12px 22px; font-size:15px; color:#211e1c; text-decoration:none;">
        <%= t("auth.mailer.reset_password.cta") %>
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 8px; font-size:13px; line-height:20px; color:#8a8279;">
  <%= t("auth.mailer.reset_password.expires", hours: (Devise.reset_password_within / 3600).to_i) %>
</p>

<p style="margin:0; font-size:13px; line-height:20px; color:#8a8279;">
  <%= t("auth.mailer.reset_password.ignore") %>
</p>
