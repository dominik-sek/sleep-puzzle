<%# Copy comes from the CMS (config/content_blocks.yml + /admin/content_blocks).
    The page is narrower than the catalogue screens — it is one column of prose,
    so it follows the design's 1000px rather than the usual 1240px. %>
<div class="flex flex-col items-center w-full">
  <%= render Section::Component.new(
    background: :ink,
    align: :left,
    bordered: false
  ) do |section| %>
    <div class="max-w-[1000px] mx-auto w-full flex flex-col gap-14">
      <div class="flex flex-col md:flex-row flex-wrap gap-10 items-start">
        <%# uploaded in the panel; until there is one, an empty frame rather than
            a broken <img> — the same treatment as the home page's portrait %>
        <div class="w-full md:flex-1 md:min-w-[220px] md:max-w-[340px]">
          <% photo = content_image("about.intro.photo",
                                   alt: content_block("about.intro.name"),
                                   class: "border border-border-strong rounded-3xl w-full aspect-square object-cover") %>

          <%= photo || tag.div(class: "border border-dashed border-border-strong rounded-3xl w-full aspect-square") %>
        </div>

        <div class="md:flex-2 md:min-w-[260px] flex-1">
          <h1 class="font-display font-bold text-t2 text-cream mb-1.5">
            <%= content_block("about.intro.name") %>
          </h1>
          <p class="text-t6 font-bold text-accent mb-5.5">
            <%= content_block("about.intro.role") %>
          </p>

          <%# divs, not spans: rich text renders a block-level trix-content wrapper %>
          <div class="text-cream mb-4.5"><%= content_block("about.intro.lead") %></div>
          <div class="text-tan mb-4.5"><%= content_block("about.intro.body") %></div>

          <blockquote class="font-display font-bold text-t3 text-accent my-6.5">
            <%= content_block("about.intro.quote") %>
          </blockquote>

          <div class="text-tan"><%= content_block("about.intro.body_after_quote") %></div>
        </div>
      </div>

      <%# a panel rather than a plain list: the design sets the credentials apart
          from the prose, and they are the one part a sceptical reader scans for %>
      <div class="rounded-3xl border border-border-strong bg-surface p-9">
        <h2 class="text-t6 font-extrabold uppercase tracking-wide text-accent mb-5">
          <%= content_block("about.certifications.title") %>
        </h2>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
          <% content_items("about.certifications").each do |certification| %>
            <li class="flex gap-2.5 text-t6 leading-relaxed text-cream">
              <span class="text-accent shrink-0" aria-hidden="true">✦</span>
              <span><%= certification["text"] %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="text-center">
        <%= render Buttons::Component.new(
          text: content_block("about.cta.label"),
          pill: true,
          variant: :primary,
          href: bookings_path,
          classes: "hover:cursor-pointer bg-accent! text-ink! py-4 px-7.5 font-bold!"
        ) %>
      </div>
    </div>
  <% end %>
</div>
