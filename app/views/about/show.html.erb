<%# Copy comes from the CMS (config/content_blocks.yml + /admin/content_blocks).
    The page is narrower than the catalogue screens — it is one column of prose,
    so it follows the design's 1000px rather than the usual 1240px. %>
<% content_for :title, page_title(t("nav.about")) %>

<div class="flex flex-col items-center w-full">
  <%= render Section::Component.new(
    background: :ink,
    align: :left
  ) do |section| %>
    <div class="max-w-[1000px] mx-auto w-full flex flex-col gap-14">
      <div class="flex flex-col md:flex-row flex-wrap gap-10 items-start">
        <div class="w-full md:flex-1 md:min-w-[220px] md:max-w-[340px]">
          <% photo = content_image("about.intro.photo",
                                   alt: content_block("about.intro.name"),
                                   class: "border border-border-strong rounded-2xl w-full aspect-square object-cover") %>

          <%# no portrait uploaded is the launch state, and it is the first thing
              on the page on a phone. A dashed frame reads as 1.43:1 of nothing —
              on a dimmed screen the page simply looks broken. The mascot is the
              brand's own piece, so the slot is filled rather than merely guarded.
              alt="": it stands in for her portrait, it does not describe her. %>
          <%= photo || image_tag("mascot-peach.png", alt: "",
                                 class: "w-full aspect-square object-contain rounded-2xl border border-border-strong bg-ink-soft p-8") %>
        </div>

        <%# max-w-prose caps the measure at ~65ch. Left to the column it ran near
            84ch at this page's 1000px, well past the 65-75ch the system documents
            for long-form reading. %>
        <div class="md:flex-2 md:min-w-[260px] flex-1 max-w-prose">
          <h1 class="font-display font-bold text-t1 text-cream mb-1.5">
            <%= content_block("about.intro.name") %>
          </h1>
          <p class="text-t5 font-bold text-cream mb-5.5">
            <%= content_block("about.intro.role") %>
          </p>

          <%# divs, not spans: rich text renders a block-level trix-content wrapper.
              trix-lead / trix-copy target that wrapper — setting a colour here
              alone does nothing, which is why the lead used to render as body. %>
          <div class="trix-lead mb-4.5"><%= content_block("about.intro.lead") %></div>
          <div class="trix-copy mb-4.5"><%= content_block("about.intro.body") %></div>

          <blockquote class="font-display font-bold text-t3 text-accent my-6.5">
            <%= content_block("about.intro.quote") %>
          </blockquote>

          <div class="trix-copy"><%= content_block("about.intro.body_after_quote") %></div>
        </div>
      </div>

      <%# a panel rather than a plain list: the design sets the credentials apart
          from the prose, and they are the one part a sceptical reader scans for.
          These four facts are the entire evidence this business is allowed to
          show — no testimonials, no counts, no case studies — so the panel is
          sized as evidence rather than as a footnote: a real subsection heading,
          reading-weight text, and an edge at border-input, which is the token
          that clears 3:1 and is meant to be seen. %>
      <div class="rounded-2xl border border-border-input bg-surface p-9">
        <h2 class="font-display font-bold text-t3 text-cream mb-1.5">
          <%= content_block("about.certifications.title") %>
        </h2>

        <%# the one credential that needs no glossary, and the only number a
            tired reader can take in at a glance %>
        <p class="text-t5 text-accent font-bold mb-5">
          <%= content_block("about.certifications.lead") %>
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
          <% content_items("about.certifications").each do |certification| %>
            <li class="flex gap-2.5 text-t5 text-cream">
              <%= icon "astroid", class: "size-4 shrink-0 mt-1 text-accent" %>
              <span><%= certification["text"] %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="flex flex-col items-center gap-2">
        <%# bg-accent!/text-ink! dropped: :primary already produces both %>
        <%= render Buttons::Component.new(
          text: content_block("about.cta.label"),
          pill: true,
          variant: :primary,
          href: bookings_path,
          classes: "hover:cursor-pointer py-4 px-7.5 font-bold!"
        ) %>
        <%# labels the wall before it is hit — bookings is behind authenticate_user!,
            and since after_sign_in_path_for honours stored_location_for the claim
            that you come back here is now true %>
        <p class="text-t6 text-taupe text-center m-0">
          <%= content_block("about.cta.reassurance") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# The page used to end on that booking pill, so the last thing a page about a
      person did was ask a stranger for money and an account ninety seconds after
      meeting her. Home and packages both close on a lower rung; this is the
      introduction, so it needs one more, not less. Secondary rather than accent:
      the booking CTA above keeps the lamp. %>
  <%= render Section::Component.new(
    background: :ink_soft,
    align: :center
  ) do |section| %>
    <div class="flex flex-col gap-4 items-center">
      <h2 class="text-t2 font-display font-bold text-cream">
        <%= content_block("about.closing.title") %>
      </h2>
      <p class="text-t4 text-tan max-w-xl m-0">
        <%= content_block("about.closing.body") %>
      </p>
    </div>

    <% section.with_actions do %>
      <div class="flex flex-col items-center gap-5">
        <%= render Buttons::Component.new(
          text: content_block("about.closing.cta"),
          pill: true,
          variant: :secondary,
          href: contact_path,
          classes: "hover:cursor-pointer text-t6! py-4 px-6 font-bold!"
        ) %>

        <p class="text-t6 text-taupe m-0">
          <%= content_block("about.closing.shop_lead") %>
          <%= link_to content_block("about.closing.shop_link"), products_path,
                      class: "text-accent no-underline hover:text-accent-hover rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
