<% chapters = product.audio_chapters.select(&:ready?) %>
<% if chapters.any? && BunnySignedUrlService.configured? %>
  <div class="mt-4" data-controller="chapter-playlist">
    <audio controls preload="none" class="w-full" data-chapter-playlist-target="player"
           data-controller="playback" data-playback-url-value="<%= playback_order_item_path(@purchase_items.fetch(product.id)) %>"
           data-action="ended->chapter-playlist#next playing->playback#record"></audio>
    <ol class="mt-3 flex flex-col gap-2 list-none p-0">
      <% chapters.each_with_index do |chapter, index| %>
        <li>
          <button type="button" class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-xl border border-border-input bg-ink-soft px-4 py-3 text-left text-t5 text-cream hover:border-accent focus-visible:outline-2 focus-visible:outline-accent"
                  data-chapter-playlist-target="chapter"
                  data-action="click->chapter-playlist#select"
                  data-index="<%= index %>"
                  data-src="<%= stream_chapter_product_path(product, chapter_id: chapter.id, order_item_id: @purchase_items.fetch(product.id).id) %>"
                  data-label="<%= t('products.player.label', name: chapter.title) %>">
            <span><%= index + 1 %>. <%= chapter.title %></span>
            <% if chapter.duration_label %><span class="shrink-0 text-taupe"><%= chapter.duration_label %></span><% end %>
          </button>
        </li>
      <% end %>
    </ol>
  </div>
<% else %>
  <p class="mt-3.5 text-t6 text-taupe"><%= content_block("dashboard.library.unplayable") %></p>
<% end %>
