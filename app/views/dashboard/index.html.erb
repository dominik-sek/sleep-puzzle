<% content_for :title, page_title(t("nav.my_account")) %>
<%# The design's Moje konto: the library, the upcoming consultation and account
    settings, each with an empty state.

    The design draws a login form here for signed-out visitors. Devise already
    owns that screen, and `authenticate_user!` sends them to it, so there is no
    second copy of a login form in this app. %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :left
  ) do |section| %>
    <div class="max-w-[1000px] mx-auto w-full">
      <div class="mb-10 flex flex-wrap items-center justify-between gap-3.5">
        <div>
          <h1 class="font-display font-bold text-t1 text-cream m-0">
            <%= content_block("dashboard.hero.title") %>
          </h1>
          <p class="mt-1.5 text-t6 text-tan m-0">
            <%= content_block("dashboard.hero.subtitle") %>
          </p>
        </div>

        <%# through the component so it carries the pill radius, the amber focus
            ring and a 44px target - hand-rolled it had a 22px radius that is
            neither pill nor piece, and fell back to the browser's blue ring %>
        <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete,
              form_class: "contents",
              class: "inline-flex items-center justify-center cursor-pointer whitespace-nowrap rounded-full border border-border-input bg-transparent px-6 py-4 text-t6 font-bold text-tan transition-colors duration-100 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
      </div>

      <%= render "dashboard/section_heading", title: content_block("dashboard.library.title") %>

      <%# Paid for, waiting on Paddle. Above the settled rows, because it is the
          only thing on this screen the buyer is actually anxious about - and the
          reason they opened it. Same row shape as below so it reads as the same
          library, one step earlier; the status pill is the one the bookings
          section already uses, so "waiting on a payment" looks the same in both
          halves of the account.

          No player: the payment is not confirmed, so there is nothing this
          account is entitled to stream yet. Saying so beats a control that 403s. %>
      <% if @awaiting.any? %>
        <%# said once for the group, not once per row. Two identical paragraphs
            stacked is reading load on a screen built for someone who has none
            to spare - the pill on each row carries the per-item state. %>
        <p class="mb-3 flex items-start gap-2 text-t6 text-tan m-0">
          <%= icon "clock", class: "mt-0.5 size-4 shrink-0" %>
          <span><%= content_block("dashboard.library.awaiting") %></span>
        </p>

        <%# the settled rows follow directly when there are any, so the gap
            between the two halves is the list's own gap rather than a break %>
        <div class="<%= @products.any? ? "mb-3" : "mb-11" %> flex flex-col gap-3">
          <% @awaiting.each do |product| %>
            <div id="<%= dom_id(product) %>"
                 class="library-row scroll-mt-24 rounded-2xl border border-border-input bg-surface px-5 py-4"
                 role="status">
              <%# stacked below sm: side by side, the pill is shrink-0 and the
                  name loses, so a long Polish title was clipped to nothing on
                  the 390px phone this site is built for %>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
                <div class="flex min-w-0 flex-1 items-center gap-4">
                  <span class="text-t3 leading-none opacity-60" aria-hidden="true"><%= product.display_icon %></span>
                  <span class="min-w-0 flex-1">
                    <span class="block">
                      <%= link_to product.name, product_path(product),
                                  class: "inline-block py-2.5 font-display font-bold text-t5 text-cream no-underline break-words hover:text-accent rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
                    </span>
                    <span class="block text-t6 text-taupe"><%= product.kind_label %></span>
                  </span>
                </div>

                <%# the bookings section's pill, unchanged: one shape for "still
                    waiting on a payment" across the whole account %>
                <span class="self-start shrink-0 inline-flex items-center gap-1.5 rounded-full border border-border-input px-3 py-1.5 text-t6 font-bold text-cream sm:self-auto">
                  <%= icon "clock", class: "size-3.5 shrink-0" %>
                  <%= content_block("dashboard.library.awaiting_status") %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @products.any? %>
        <div class="mb-11 flex flex-col gap-3">
          <% @products.each do |product| %>
            <%# id + scroll-mt: the shop's "Posłuchaj w koncie" button links straight
                to this row, and scroll-mt keeps it clear of the sticky navbar.
                library-row is what the :target rule in application.css hangs off,
                so an arriving buyer sees which one they just came for.

                The link is on the name only. It used to wrap the whole row, which
                made the biggest target on the page a route back to the product's
                sales page - for something the reader already owns. %>
            <div id="<%= dom_id(product) %>"
                 class="library-row scroll-mt-24 rounded-2xl border border-border-strong bg-surface px-5 py-4">
              <div class="flex items-center gap-4">
                <span class="text-t3 leading-none" aria-hidden="true"><%= product.display_icon %></span>
                <span class="flex-1 min-w-0">
                  <%# inline-block + py-2: narrowing this from the whole row fixed
                      where it points but left a 19px target. Display-For-Names
                      covers a product's name, so Baloo rather than Quicksand.
                      Wraps rather than truncates - Polish runs long, and the one
                      screen that confirms what you own must not clip its name. %>
                  <span class="block">
                    <%= link_to product.name, product_path(product),
                                class: "inline-block py-2.5 font-display font-bold text-t5 text-cream no-underline break-words hover:text-accent rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
                  </span>
                  <span class="block text-t6 text-taupe"><%= product.kind_label %></span>
                </span>
              </div>

              <%# preload="none" so nothing is fetched and no token is minted until
                  play is actually pressed. Products with no file uploaded keep the
                  plain row - a control with nothing behind it would be a lie. %>
              <% if product.streamable? %>
                <audio controls preload="none" class="mt-3.5 w-full"
                       src="<%= stream_product_path(product) %>"
                       aria-label="<%= t('products.player.label', name: product.name) %>"></audio>
              <% else %>
                <%# Still no control - one with nothing behind it would be a lie -
                    but silence was worse: a buyer saw something they had paid for,
                    no player, and no reason. Says so, and gives them the one route
                    that works. The panel flags the same row for the owner. %>
                <p class="mt-3.5 text-t6 text-taupe m-0">
                  <%= content_block("dashboard.library.unplayable") %>
                  <%= link_to content_block("dashboard.library.unplayable_link"), contact_path,
                              class: "font-bold text-accent no-underline hover:text-accent-hover rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% elsif @awaiting.none? %>
        <%# only when nothing is settled *and* nothing is on its way - "you don't
            have any audio yet" is a lie to someone whose card was just charged %>
        <%= render "dashboard/empty_state",
                   body: content_block("dashboard.library.empty"),
                   label: content_block("dashboard.library.empty_link"),
                   href: products_path,
                   icon: "🌙" %>
      <% end %>

      <%= render "dashboard/section_heading", title: content_block("dashboard.bookings.title") %>

      <% if @bookings.any? %>
        <div class="mb-11 flex flex-col gap-3">
          <% @bookings.each do |booking| %>
            <div class="flex items-center gap-4 rounded-2xl border border-border-strong bg-surface px-5.5 py-4.5">
              <span class="text-t3 leading-none" aria-hidden="true">📅</span>
              <div class="flex-1 min-w-0">
                <%# Baloo: Display-For-Names covers durations and dates %>
                <div class="font-display font-bold text-t5 text-cream">
                  <%= l(booking.starts_at, format: :long) %>
                </div>
                <div class="text-t6 text-taupe"><%= booking.package.name %></div>
              </div>

              <%# only when it is not simply confirmed: a booking still waiting on
                  a payment has to say so, or the buyer reads it as settled %>
              <% unless booking.confirmed? %>
                <span class="shrink-0 rounded-full border border-border-input px-3 py-1.5 text-t6 font-bold text-cream">
                  <%= booking.status_label %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render "dashboard/empty_state",
                   body: content_block("dashboard.bookings.empty"),
                   label: content_block("dashboard.bookings.empty_link"),
                   href: bookings_path,
                   icon: "📅" %>
      <% end %>

      <%= render "dashboard/section_heading", title: content_block("dashboard.settings.title") %>

      <%# the design leaves this a block of text; Devise already owns the form, so
          this points at it rather than growing a second one %>
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-border-strong bg-surface p-5.5">
        <div>
          <%# a Google sign-up has never had a password, so promising to change one
              is a promise the next screen contradicts - it offers to *set* one.
              The controller and the Devise view already branch on this; only the
              summary here did not. %>
          <p class="text-t6 text-tan m-0">
            <%= content_block(current_user.password_set? ? "dashboard.settings.body" : "dashboard.settings.body_no_password") %>
          </p>
          <p class="mt-1 text-t6 text-taupe m-0"><%= current_user.email %></p>
        </div>

        <%= render Buttons::Component.new(
          text: content_block("dashboard.settings.cta"),
          href: edit_user_registration_path,
          pill: true,
          variant: :outline,
          classes: "hover:cursor-pointer text-t6! font-bold! py-4 px-6"
        ) %>
      </div>
    </div>
  <% end %>
</div>
