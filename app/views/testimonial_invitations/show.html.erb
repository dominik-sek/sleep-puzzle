<% content_for :title, page_title(t("testimonials.form_title")) %>
<% content_for :head do %><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><% end %>

<section class="w-full bg-ink px-5 py-16">
  <div class="mx-auto max-w-[680px] rounded-2xl border border-border-strong bg-surface p-6 sm:p-10">
    <% if @invitation.open? %>
      <h1 class="font-display text-t2 font-bold text-cream"><%= t("testimonials.form_title") %></h1>
      <p class="mt-3 text-t5 text-tan"><%= t("testimonials.form_intro") %></p>

      <%= form_with model: @invitation, url: testimonial_invitation_path(@invitation.token), method: :patch,
                    class: "mt-8 flex flex-col gap-5" do |f| %>
        <div class="flex flex-col gap-2">
          <%= f.label :quote, t("testimonials.quote_label"), class: "text-t5 font-bold text-cream" %>
          <%= f.text_area :quote, rows: 7, maxlength: 2_000, required: true,
                          class: "form-control resize-y", aria: { invalid: @invitation.errors[:quote].any? } %>
          <% if @invitation.errors[:quote].any? %><p class="text-t6 text-red-400"><%= @invitation.errors[:quote].to_sentence %></p><% end %>
        </div>

        <div class="flex flex-col gap-2">
          <%= f.label :author, t("testimonials.author_label"), class: "text-t5 font-bold text-cream" %>
          <%= f.text_field :author, maxlength: 100, required: true, class: "form-control",
                           aria: { invalid: @invitation.errors[:author].any? } %>
          <p class="text-t6 text-taupe"><%= t("testimonials.author_hint") %></p>
          <% if @invitation.errors[:author].any? %><p class="text-t6 text-red-400"><%= @invitation.errors[:author].to_sentence %></p><% end %>
        </div>

        <div>
          <label class="flex items-start gap-3 text-t6 text-tan">
            <%= f.check_box :publication_consent, required: true, class: "mt-1 accent-accent" %>
            <span><%= t("testimonials.consent_label") %></span>
          </label>
          <% if @invitation.errors[:publication_consent].any? %><p class="text-t6 text-red-400"><%= t("testimonials.consent_error") %></p><% end %>
          <p class="mt-2 text-t6 text-taupe"><%= link_to t("testimonials.privacy"), privacy_path, class: "text-accent" %></p>
        </div>

        <%= f.submit t("testimonials.submit"), class: "self-start rounded-full bg-accent px-7 py-3 font-bold text-ink cursor-pointer hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
      <% end %>
    <% else %>
      <h1 class="font-display text-t2 font-bold text-cream"><%= t("testimonials.thanks_title") %></h1>
      <p class="mt-3 text-t5 text-tan"><%= t("testimonials.thanks_body") %></p>
    <% end %>
  </div>
</section>
