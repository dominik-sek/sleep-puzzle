<%= render Container::Component.new(classes:"flex flex-col gap-6 items-center justify-center") do %>
<div class="flex flex-col justify-center items-center text-center gap-6 w-1/2">
  <h1 class="text-t2 text-cream font-display">Umów konsultację</h1>
  <span class="text-tan text-t5">Wybierz dogodny termin w kalendarzu, a potem uzupełnij krótki formularz zgłoszeniowy</span>
</div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full" data-controller="cally" data-cally-available-dates-value="<%= @available_dates %>" data-cally-no-slots-label-value="<%= t("bookings.available_slots", count: 0) %>">
    <%= render Card::Component.new(classes: "self-start") do %>
      <calendar-date data-cally-target="calendarDate" data-action="change->cally#dateChanged" class="w-full" format-weekday="short">
        <svg
          aria-label="Previous"
          slot="previous"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <svg
          aria-label="Next"
          slot="next"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
        <calendar-month data-cally-target="calendarMonth" class="w-full"></calendar-month>
      </calendar-date>
    <% end %>

    <%= render Card::Component.new(classes: "h-fit") do %>
      <div class="flex flex-col gap-5">
        <div>
          <div class="flex justify-between">
            <h2 class="font-display text-t4 pb-4">Dostępne godziny - <span data-cally-target="heading"></span></h2>
            <span data-cally-target="availableCount"></span>
          </div>
          <% @availability[:dates].each do |date| %>
            <% available_count = date[:hours].count { |hour| hour[:available] } %>
            <div data-cally-target="hoursPanel" data-date="<%= date[:date] %>" data-available-label="<%= t("bookings.available_slots", count: available_count) %>" hidden class="grid grid-cols-3 gap-4">
              <% date[:hours].each do |hour| %>
                <%= render Buttons::Component.new(
                  text: hour[:hour],
                  disabled: !hour[:available],
                  variant: :secondary,
                  classes: "text-t5! hover:cursor-pointer disabled:text-border-input",
                  data: { action: "click->cally#timeSelected", hour: hour[:hour] }
                ) %>

              <% end %>
            </div>
          <% end %>
        </div>

        <div data-cally-target="slotForm" hidden>
          <hr class="border-border my-4"/>
          <%= render "form", booking: @booking %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
