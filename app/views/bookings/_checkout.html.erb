<%# empty when checkout couldn't be prepared, so the turbo_stream still clears any previous one %>
<%= tag.div id: "paddle_checkout", data: (checkout && {
      controller: "paddle",
      paddle_price_id_value: checkout[:price_id],
      paddle_customer_id_value: checkout[:customer_id],
      paddle_booking_id_value: checkout[:booking_id],
      paddle_success_url_value: checkout[:success_url]
    }) %>
