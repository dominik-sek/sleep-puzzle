<div id="booking_status" data-payment-status-target="panel" class="w-full max-w-xl flex flex-col gap-6 text-center [overflow-wrap:anywhere]">
  <% if booking.canceled_at? %>
    <h1 class="page-title"><%= content_block("refunds.notifications.canceled_title") %></h1>
    <p class="text-tan text-t5"><%= content_block("refunds.notifications.canceled_body") %></p>
  <% elsif booking.confirmed? %>
    <h1 class="page-title"><%= t("bookings.summary.confirmed_title") %></h1>
    <span class="text-tan text-t5">
      <%= t("bookings.summary.confirmed_body") %>
    </span>
  <% elsif booking.payment_failed? || booking.canceled? %>
    <h1 class="page-title"><%= t("bookings.summary.failed_title") %></h1>
    <span class="text-tan text-t5">
      <%= t("bookings.summary.failed_body") %>
    </span>
  <% else %>
    <h1 class="page-title"><%= t("bookings.summary.processing_title") %></h1>
    <span class="text-tan text-t5">
      <%= t("bookings.summary.processing_body") %>
    </span>
  <% end %>

  <%= render Card::Component.new(variant: :well, padding: :lg) do |card| %>
    <% card.with_body do %>
      <% if booking.pending? %>
        <%# the webhook decides what actually goes in this card, so until it lands the
            card holds the spinner rather than a half-true summary %>
        <div class="flex items-center justify-center py-6" role="status" aria-live="polite">
          <%= render LoadingIndicator::Component.new(
            type: :spinner,
            size: :xl,
            color: :accent,
            text: t("bookings.status.awaiting"),
            classes: "flex-col text-center"
          ) %>
        </div>
      <% else %>
        <dl class="flex flex-col gap-3 text-left">
          <div class="grid min-w-0 grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
            <dt class="text-tan text-t5"><%= t("bookings.summary.package") %></dt>
            <dd class="min-w-0 text-cream text-t5 [overflow-wrap:anywhere]"><%= booking.package.name %></dd>
          </div>
          <div class="grid min-w-0 grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
            <dt class="text-tan text-t5"><%= t("bookings.summary.starts_at") %></dt>
            <dd class="min-w-0 text-cream text-t5 [overflow-wrap:anywhere]"><%= l booking.starts_at, format: :long, default: booking.starts_at.to_fs(:short) %></dd>
          </div>
          <div class="grid min-w-0 grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
            <dt class="text-tan text-t5"><%= t("bookings.summary.payment_status") %></dt>
            <dd class="min-w-0 text-cream text-t5 [overflow-wrap:anywhere]"><%= content_block(booking.confirmed_at? ? "refunds.notifications.paid" : "refunds.notifications.unpaid") %></dd>
          </div>
          <div class="grid min-w-0 grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
            <dt class="text-tan text-t5"><%= content_block("refunds.notifications.booking_status") %></dt>
            <dd class="min-w-0 text-cream text-t5 [overflow-wrap:anywhere]"><%= booking.status_label %></dd>
          </div>
          <% if booking.canceled_at? || booking.refund_adjustments.exists? %>
            <div class="grid min-w-0 grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
              <dt class="text-tan text-t5"><%= content_block("refunds.notifications.refund_status") %></dt>
              <dd class="min-w-0 text-cream text-t5 [overflow-wrap:anywhere]"><%= booking.refund_label %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    <% end %>
  <% end %>

  <% if booking.confirmed? %>
    <%= render Buttons::Component.new(
      text: t("bookings.status.back"),
      href: dashboard_index_path,
      variant: :primary,
      pill: true,
      classes: "min-h-11 whitespace-normal! py-4 text-t6! font-bold!"
    ) %>
  <% end %>
</div>
