<div id="availability" class="relative grid grid-cols-1 md:grid-cols-2 gap-6 w-full"
     data-controller="cally"
     data-cally-available-dates-value="<%= available_dates %>"
     data-cally-no-slots-label-value="<%= t("bookings.available_slots", count: 0) %>"
     data-cally-locale-value="<%= I18n.locale %>"
     data-action="paddle:completed@window->cally#lock pageshow@window->cally#unlock">
  <%# spans the grid rather than sitting in a column: it explains both halves at
      once, and without it a calendar with every slot disabled just reads as
      "fully booked for two months" %>
  <% if unavailable %>
    <div role="status" class="md:col-span-2 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-t6 font-normal leading-relaxed text-amber-200">
      <%= t("bookings.calendar.unavailable") %>
    </div>
  <% end %>

  <%= render Card::Component.new(classes: "self-start") do %>
    <calendar-date data-cally-target="calendarDate" data-action="change->cally#dateChanged focusday->cally#monthChanged" class="w-full" format-weekday="short">
      <%# cally renders the year between the arrows and the month above the grid; we collapse
          both into a single "Miesiąc Rok" label filled in by cally_controller %>
      <div slot="heading" data-cally-target="monthHeading"></div>
      <svg
        aria-label="<%= t("bookings.calendar.previous_month") %>"
        slot="previous"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      <svg
        aria-label="<%= t("bookings.calendar.next_month") %>"
        slot="next"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
      <calendar-month data-cally-target="calendarMonth" class="w-full"></calendar-month>
    </calendar-date>
  <% end %>

  <%= render Card::Component.new(classes: "h-fit") do %>
    <div class="flex flex-col gap-5">
      <div>
        <%# starts hidden — cally_controller reveals it once a day is picked %>
        <%# stacked until lg: the card is half the grid from md up, so a row only
            has room for both the date and the count on a real desktop %>
        <div data-cally-target="hoursHeader" hidden class="flex flex-col gap-1 mb-4 lg:flex-row lg:items-baseline lg:justify-between lg:gap-4">
          <h2 class="font-display text-t4"><%= t("bookings.calendar.available_hours") %> - <span data-cally-target="heading"></span></h2>
          <span class="text-t6 text-taupe whitespace-nowrap" data-cally-target="availableCount"></span>
        </div>

        <p data-cally-target="emptyState" class="text-t5 text-taupe">
          <%= t("bookings.calendar.pick_a_day") %>
        </p>

        <% availability[:dates].each do |date| %>
          <% available_count = date[:hours].count { |hour| hour[:available] } %>
          <div data-cally-target="hoursPanel" data-date="<%= date[:date] %>" data-available-label="<%= t("bookings.available_slots", count: available_count) %>" hidden class="grid grid-cols-3 gap-4">
            <% date[:hours].each do |hour| %>
              <%= render Buttons::Component.new(
                text: hour[:hour],
                disabled: !hour[:available],
                variant: :secondary,
                classes: "text-t5! hover:cursor-pointer disabled:text-taupe-dark",
                data: { action: "click->cally#timeSelected", hour: hour[:hour] }
              ) %>

            <% end %>
          </div>
        <% end %>
      </div>

      <div data-cally-target="slotForm" hidden>
        <hr class="border-border my-4"/>
        <%= render "form", booking: booking, package_options: package_options %>
      </div>
    </div>
  <% end %>

  <%# dropped over the calendar the moment Paddle reports the payment as complete, so the
      grid can't be clicked during the hop to the confirmation page %>
  <div data-cally-target="overlay" hidden role="status" aria-live="polite"
       class="absolute inset-0 z-20 flex items-center justify-center bg-ink/70 backdrop-blur-xs">
    <%= render Card::Component.new(padding: :lg, shadow: :xl, classes: "max-w-xs") do %>
      <div class="flex flex-col items-center gap-3 text-center">
        <%= render LoadingIndicator::Component.new(type: :spinner, size: :lg, color: :accent) %>
        <p class="text-cream text-t5"><%= t("bookings.calendar.processing") %></p>
        <p class="text-taupe text-t6 font-normal tracking-normal"><%= t("bookings.calendar.processing_hint") %></p>
      </div>
    <% end %>
  </div>
</div>
