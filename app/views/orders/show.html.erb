<% content_for :title, page_title(t("nav.cart")) %>
<%# Where Paddle sends the buyer once payment goes through. The order is still
    pending at this point more often than not - the webhook is what flips it -
    so the status partial is swapped in over a stream instead of leaving the
    buyer on a page that tells them to keep refreshing. %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :center
  ) do |section| %>
    <%= turbo_stream_from @order %>
    <%= render "orders/status", order: @order %>
  <% end %>
</div>
