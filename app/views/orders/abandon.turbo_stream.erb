<%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash" %>
<% end %>

<%# the abandoned order's lines are back in the cart by now %>
<%= turbo_stream.replace "cart" do %>
  <%= render "cart/cart", cart: current_cart %>
<% end %>

<%= turbo_stream.replace "cart_badge" do %>
  <%= render "shared/cart_badge" %>
<% end %>

<%# only on the shop page; a stream for a target that is not on this page is a
    no-op, so both can be sent unconditionally %>
<%= turbo_stream.replace "cart_pill" do %>
  <%= render "shared/cart_pill" %>
<% end %>

<%# drops the spent controller, so the next checkout's stream connects a fresh one %>
<%= turbo_stream.replace "paddle_checkout" do %>
  <%= render "shared/paddle_checkout", checkout: nil %>
<% end %>
