<dialog id="<%= package_details_id(package) %>" class="package-details-dialog rounded-2xl border border-border-strong bg-surface text-left text-cream shadow-xl"
        aria-labelledby="<%= package_details_id(package) %>-title"
        data-action="click->package-details#backdrop cancel->package-details#cancel close->package-details#closed keydown->package-details#trapFocus focusin->package-details#focusHeading">
  <div class="flex shrink-0 items-start justify-between gap-4 border-b border-border-strong bg-surface p-5">
    <div class="min-w-0">
      <p class="text-t6 text-taupe m-0 mb-1"><%= content_block("packages.details.title") %></p>
      <h2 id="<%= package_details_id(package) %>-title" tabindex="-1" class="text-t3 font-display text-accent break-words outline-none" data-dialog-heading><%= package.name %></h2>
    </div>
    <%= button_tag content_block("packages.details.close"), type: "button", data: { action: "click->package-details#close" },
                   class: "min-h-11 shrink-0 cursor-pointer rounded-full border border-border-input px-4 text-t6 text-cream hover:bg-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
  </div>
  <div class="package-details-scroll flex flex-col gap-6 p-5 sm:p-7 text-t5 text-tan break-words">
    <% if package.for_whom.present? %>
      <p class="m-0"><%= package.for_whom %></p>
    <% end %>
    <% if package.highlights.size > Package::CARD_HIGHLIGHTS_LIMIT %>
      <div>
        <h3 class="text-t3 font-display text-cream mb-3"><%= content_block("packages.details.more_highlights") %></h3>
        <ul class="list-disc pl-5 space-y-2">
          <% package.highlights.drop(Package::CARD_HIGHLIGHTS_LIMIT).each do |highlight| %>
            <li><%= highlight %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% { core: "packages.card.core", extra: "packages.card.extra" }.each do |field, heading| %>
      <% if package.public_send(field).any? %>
        <div>
          <h3 class="text-t3 font-display text-cream mb-3"><%= content_block(heading) %></h3>
          <ul class="list-disc pl-5 space-y-3">
            <% package.public_send(field).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
    <% if package.organization.present? %>
      <div>
        <h3 class="text-t3 font-display text-cream mb-3"><%= content_block("packages.details.organization") %></h3>
        <%= simple_format(package.organization, class: "mb-4 last:mb-0") %>
      </div>
    <% end %>
    <% if shared_body.present? %>
      <div>
        <h3 class="text-t3 font-display text-cream mb-3"><%= content_block("packages.shared.title") %></h3>
        <div class="trix-copy"><%= shared_body %></div>
      </div>
    <% end %>
  </div>
  <% price_label = package_price_label(package) %>
  <div class="shrink-0 border-t border-border-strong bg-surface px-5 py-4" data-action="click->package-details#follow">
    <%= render Buttons::Component.new(
      text: price_label ? t("offers.see_times") : content_block("packages.card.unavailable_cta"),
      pill: true, variant: price_label ? :primary : :secondary,
      href: price_label ? (user_signed_in? ? bookings_path(package_id: package.id) : packages_path(anchor: "calendar")) : instagram_contact_url,
      aria_label: "#{price_label ? t('offers.see_times') : content_block('packages.card.unavailable_cta')} - #{package.name}",
      classes: "text-t6! py-4 px-6 font-bold! w-full justify-center"
    ) %>
  </div>
</dialog>
