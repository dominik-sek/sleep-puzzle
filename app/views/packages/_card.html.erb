<%#
  A compact overview; full benefits, add-ons and organization live in the
  modal. Old records without highlights still have all their details.

  The price comes from Paddle rather than from us (see Purchasable), so it can be
  missing - archived in Paddle, or Paddle unreachable. The card still renders,
  without the amount and without a booking button: sending someone into a login
  wall, a calendar and a form for something that cannot be checked out is worse
  than showing it as unavailable here. Same rule the shop already follows in
  products/_card.

  locals: package
%>
<% price_label = package_price_label(package) %>
<% preview = local_assigns.fetch(:preview, false) %>

<%= render Card::Component.new(classes: "grow flex flex-col", stretch_body: true) do |card| %>
  <% card.with_body do %>
    <div class="flex grow flex-col gap-6 text-left">
      <div class="flex flex-col gap-2">
        <%# break-words: a long Polish compound in a ~370px column would otherwise
            clip against the card's overflow-hidden wrapper rather than wrap %>
        <h2 class="text-accent! font-display text-t3! break-words"><%= package.name %></h2>

        <% if package.duration %>
          <span class="text-t6 font-display text-taupe">
            <%= t("packages.duration", count: package.duration) %>
          </span>
        <% end %>

        <%# the number a parent actually came for. tabular-nums so amounts line up
            down a row of cards %>
        <p class="text-t3 font-display font-bold text-cream tabular-nums m-0">
          <%= price_label || content_block("packages.card.unavailable") %>
        </p>
      </div>

      <% if package.card_summary.present? %>
        <div class="flex flex-col gap-1.5">
          <span class="text-t6 uppercase text-taupe"><%= content_block("packages.card.for_whom") %></span>
          <p class="text-t5 text-tan break-words"><%= package.card_summary %></p>
        </div>
      <% end %>

      <% if package.card_highlights.any? %>
        <div class="flex flex-col gap-2">
          <span class="text-t6 uppercase text-taupe"><%= content_block("packages.card.highlights") %></span>

          <ul class="flex flex-col gap-2 list-none p-0 m-0">
            <% package.card_highlights.each do |benefit| %>
              <li class="flex items-start gap-2 text-t5 text-cream">
                <%= icon "circle-check", class: "size-4 shrink-0 mt-1 text-accent" %>
                <span class="min-w-0 break-words"><%= benefit %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# mt-auto pins the button to the bottom, so the CTAs line up across a row
          of cards whose lists are different lengths %>
      <div class="mt-auto pt-2 flex flex-col gap-2">
        <%= button_tag content_block("packages.card.details"), type: "button",
                       aria: { label: "#{content_block('packages.card.details')} - #{package.name}", controls: package_details_id(package), haspopup: "dialog" },
                       data: { action: "click->package-details#reveal" },
                       class: "inline-flex min-h-12 w-full cursor-pointer items-center justify-center rounded-full border border-border-input px-6 py-3 text-t5 font-bold text-cream transition-colors duration-100 hover:bg-ink-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" %>
        <% if price_label %>
          <%# aria_label carries the package name. The visible label is the owner's
              copy and is the same words on every card, so a screen reader tabbing
              this page would otherwise hear the identical link N times with no way
              to tell which package it is on. py-4 rather than py-3 to clear a 44px
              thumb target; the type stays at Label size, which is what DESIGN.md
              assigns to button text. %>
          <%= render Buttons::Component.new(
            text: t("offers.see_times"),
            pill: true,
            variant: :primary,
            href: preview ? nil : (user_signed_in? ? bookings_path(package_id: package.id) : packages_path(anchor: "calendar")),
            type: "button", disabled: preview,
            aria_label: "#{t('offers.see_times')} - #{package.name}",
            classes: "hover:cursor-pointer text-t6! py-4 px-6 font-bold! w-full justify-center"
          ) %>
          <%# The booking form still lets a signed-in buyer change this package. %>
          <p class="text-t6 text-taupe text-center m-0"><%= t(user_signed_in? && !preview ? "offers.calendar_intro_signed_in" : "offers.calendar_intro") %></p>
        <% else %>
          <%# nothing sellable here: offer the one route that still works rather
              than a button into a checkout that cannot complete %>
          <%= render Buttons::Component.new(
            text: content_block("packages.card.unavailable_cta"),
            pill: true,
            variant: :secondary,
            href: preview ? nil : instagram_contact_url,
            type: "button", disabled: preview,
            aria_label: "#{content_block('packages.card.unavailable_cta')} - #{package.name}",
            classes: "hover:cursor-pointer text-t6! py-4 px-6 font-bold! w-full justify-center"
          ) %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
