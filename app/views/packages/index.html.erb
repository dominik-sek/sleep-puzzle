<% content_for :title, page_title(t("nav.packages")) %>
<div class="min-h-screen flex flex-col items-center">
  <%= render Section::Component.new(
    background: :ink,
    align: :center
  ) do |section| %>
    <div class="flex flex-col gap-4 items-center">
      <h1 class="text-t1 font-display font-bold text-cream">
        <%= content_block("packages.hero.title") %>
      </h1>
      <div class="text-t4 text-tan max-w-2xl">
        <%= content_block("packages.hero.subtitle") %>
      </div>
      <div class="trix-copy max-w-2xl"><%= content_block("packages.collaboration.body") %></div>
    </div>

    <% if @packages.any? %>
      <%# Three packages use three explicit columns from tablet width upward, so
          the last card cannot wrap just because a minimum card width is unmet.
          One or two packages keep their narrower, centred layout. %>
      <% layout = { 1 => "sm:grid-cols-1 max-w-[376px]", 2 => "sm:grid-cols-2 max-w-[776px]" }.fetch(@packages.size, "sm:grid-cols-2 md:grid-cols-3 max-w-[1176px]") %>
      <div class="grid grid-cols-1 items-stretch gap-6 w-full <%= layout %>">
        <% @packages.each do |package| %>
          <%# anchor for the home page's "Zobacz szczegóły"; scroll-mt keeps the
              card clear of the navbar when it is jumped to %>
          <div id="<%= dom_id(package) %>" class="scroll-mt-24 flex min-w-0 flex-col">
            <%= render "packages/card", package: package %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-t4 text-tan max-w-2xl">
        <%= content_block("packages.empty.body") %>
      </p>
    <% end %>
  <% end %>

  <section id="calendar" class="w-full scroll-mt-24 bg-ink px-5 py-16">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-t2 font-bold text-cream"><%= t("offers.calendar_title") %></h2>
        <p class="text-t5 text-tan"><%= t("offers.calendar_intro") %></p>
      </div>
      <%= render "bookings/calendar", availability: @availability,
                 available_dates: @available_dates, unavailable: @calendar_unavailable,
                 no_slots: @no_slots, preview: true %>
    </div>
  </section>

  <%= render "shared/testimonials" %>

  <%# The page used to end on N identical requests for money and nothing else.
      This closes on the two things it never offered: a way to ask a question,
      and the cheaper rung of the ladder for a family that cannot reach 1:1 yet.
      Secondary rather than accent - it is an alternative to buying, not another
      push, and the cards above already hold the lamp. Renders in the empty state
      too, where it is the only exit the page has. %>
  <%= render Section::Component.new(
    background: :ink_soft,
    align: :center
  ) do |section| %>
    <div class="flex flex-col gap-4 items-center">
      <h2 class="text-t2 font-display font-bold text-cream">
        <%= content_block("packages.closing.title") %>
      </h2>
      <p class="text-t4 text-tan max-w-xl m-0">
        <%= content_block("packages.closing.body") %>
      </p>
    </div>

    <% section.with_actions do %>
      <div class="flex flex-col items-center gap-5">
        <%= render Buttons::Component.new(
          text: t("offers.instagram_cta"),
          pill: true,
          variant: :secondary,
          href: instagram_contact_url,
          classes: "hover:cursor-pointer text-t6! py-4 px-6 font-bold!"
        ) %>

        <p class="text-t6 text-taupe m-0">
          <%= content_block("packages.closing.shop_lead") %>
          <%= link_to content_block("packages.closing.shop_link"), products_path,
                      class: "text-accent no-underline hover:text-accent-hover rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
