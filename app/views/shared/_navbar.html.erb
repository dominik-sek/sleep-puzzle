<%= render(Navbar::Component.new(variant: :transparent, sticky: true, classes:"w-full text-t5 bg-surface-dark border-b border-border-strong py-1")) do |navbar| %>
  <% navbar.with_logo do %>
    <a href="/" class="flex items-center gap-4 py-2 px-6">
      <span class="font-display text-t3 text-cream">
        sleep.puzzle
      </span>
    </a>
  <% end %>

  <%# One list, two presentations: inline in the bar here, and again in the
      hamburger panel below. Both read NavigationHelper#primary_nav_items, so a
      new link only has to be added once. mobile_hidden drops these out of the bar
      below lg, where the hamburger takes over. %>
  <% primary_nav_items.each do |item| %>
    <% navbar.with_item(label: item[:label], href: item[:href], mobile_hidden: true) %>
  <% end %>

  <%# What the hamburger opens. Without a dropdown content whose id matches the
      button's data-content-id, navbar#openMenu finds nothing and returns, which
      is why the button used to do nothing at all. %>
  <% navbar.with_dropdown_content(id: "mobile-menu-content") do %>
    <div class="flex flex-col">
      <% primary_nav_items.each do |item| %>
        <%= link_to item[:label], item[:href], class: "block rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft hover:text-accent" %>
      <% end %>

      <hr class="my-2 border-border" />

      <%# the bar's basket is hidden below lg along with the rest of the actions %>
      <%= link_to cart_path, class: "block rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft hover:text-accent" do %>
        🧺 Koszyk<%= " (#{current_cart.count})" if current_cart.count.positive? %>
      <% end %>

      <% if user_signed_in? %>
        <%= button_to "Moje konto", dashboard_index_path, method: :get, class: "block w-full text-left rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
        <% if current_user.admin? %>
          <%= button_to "Panel", admin_root_path, method: :get, class: "block w-full text-left rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
        <% end %>
        <%= button_to "Wyloguj się", destroy_user_session_path, method: :delete, class: "block w-full text-left rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
      <% else %>
        <%= link_to "Zaloguj się", new_user_session_path, class: "block rounded-md px-3 py-2.5 text-md font-bold text-cream no-underline hover:bg-ink-soft hover:text-accent" %>
      <% end %>

      <div class="mt-2 px-1">
        <%= render Buttons::Component.new(
          text: "Umów konsultację",
          pill: true,
          variant: :secondary,
          href: bookings_path,
          full_width: true,
          classes: "hover:cursor-pointer bg-accent! font-bold! text-ink!"
        ) %>
      </div>
    </div>
  <% end %>

  <% navbar.with_actions do %>
    <%# hidden below sm: these repeat inside the hamburger panel, and side by side
        with it they push the bar wider than the screen %>
    <li class="ml-2 pl-2 border-l border-border w-full hidden lg:flex gap-2 items-center">
      <%= render "shared/cart_badge" %>
      <% if user_signed_in? %>
        <button type="button"
                data-navbar-target="trigger"
                data-content-id="profile-content"
                aria-controls="profile-content"
                aria-expanded="false"
                data-align="end"
                data-action="click->navbar#toggleMenu pointerenter->navbar#handlePointerEnter pointermove->navbar#handlePointerMove pointerleave->navbar#handlePointerLeave keydown->navbar#handleTriggerKeydown"
                data-state="closed"
                class="group hover:cursor-pointer flex items-center gap-2 rounded-md px-2 py-2 text-sm font-medium text-cream select-none hover:bg-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          <% if current_user.avatar_url.present? %>
            <%= image_tag current_user.avatar_url, class: "size-6 rounded-full object-cover", alt: "" %>
          <% else %>
            <div class="flex items-center justify-center size-6 rounded-full bg-gradient-to-br from-red-400 to-red-600 text-white text-xs font-semibold">
              <%= current_user.initials %>
            </div>
          <% end %>
        </button>

        <% navbar.with_dropdown_content(id: "profile-content", width: "fit") do %>
          <%= button_to "Moje konto", dashboard_index_path, method: :get, class: "block rounded-md px-3 py-2 text-sm font-medium text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
          <% if current_user.admin? %>
            <%= button_to "Panel", admin_root_path, method: :get, class: "block rounded-md px-3 py-2 text-sm font-medium text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
          <% end %>
          <hr/>
          <%= button_to "Wyloguj się", destroy_user_session_path, method: :delete, class: "block rounded-md px-3 py-2 text-sm font-medium text-cream no-underline hover:bg-ink-soft cursor-pointer bg-transparent border-0" %>
        <% end %>

      <% else %>
        <%= render Buttons::Component.new(
          text: "Zaloguj się",
          href: "/users/sign_in",
          pill: true,
          variant: :secondary,
          classes: "hover:cursor-pointer bg-accent! font-bold! text-ink!"
        ) %>
      <% end %>
      <%= render Buttons::Component.new(
        text: "Umów konsultację",
        pill: true,
        variant: :secondary,
        href: bookings_path,
        classes: "hover:cursor-pointer bg-accent! font-bold! text-ink!"
      ) %>
    </li>
  <% end %>


<% end %>
