<%= render(Navbar::Component.new(variant: :transparent, sticky: true, classes:"w-full text-t5 bg-ink")) do |navbar| %>
  <% navbar.with_logo do %>
    <a href="/" class="flex items-center gap-4 py-2 px-6">
      <span class="font-display text-t3 text-cream">
        sleep.puzzle
      </span>
    </a>
  <% end %>

  <% navbar.with_item(label: "Pakiety", href: "#") %>
  <% navbar.with_item(label: "O mnie", href: "#") %>
  <% navbar.with_item(label: "Blog", href: "#") %>
  <% navbar.with_item(label: "Sklep", href: "#") %>
  <% navbar.with_item(label: "Kontakt", href: "#") %>

  <% navbar.with_actions do %>
    <li class="ml-2 pl-2 border-l border-neutral-200 dark:border-neutral-700 w-full flex items-center">
      <% if user_signed_in? %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block rounded-md px-3 py-2 text-sm font-medium text-neutral-700 no-underline hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer bg-transparent border-0" %>
      <% else %>
        <a href="/users/sign_in" class="block rounded-md px-3 py-2 text-sm font-medium text-neutral-700 no-underline hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">
          Sign in
        </a>
      <% end %>
      <%= render Buttons::Component.new(
        text: "Umów konsultację",
        pill: true,
        variant: :secondary,
        classes: "hover:cursor-pointer bg-accent! font-bold! text-ink!"
      ) %>
    </li>
  <% end %>
<% end %>
