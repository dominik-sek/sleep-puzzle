<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:20px 0; border-collapse:collapse;">
  <% rows.each do |label, value| %>
    <tr>
      <td style="padding:10px 0; border-bottom:1px solid #eceae5; color:#8a8279; font-size:14px;"><%= label %></td>
      <td style="padding:10px 0; border-bottom:1px solid #eceae5; color:#211e1c; font-size:14px; text-align:right;"><%= value %></td>
    </tr>
  <% end %>
</table>
