<section class="<%= wrapper_classes %>">
  <div class="section-padding max-w-[1240px] mx-auto w-full">
  <% if @title %>
    <div class="flex flex-col md:flex-row gap-8">
      <div class="flex flex-col gap-8 md:max-w-1/2">
        <div class="flex flex-col gap-4">
          <span class="text-t1 font-display font-bold text-cream">
            <%= title %>
          </span>
          <% if @subtitle %>
            <span class="text-t4 text-tan max-w-3/4">
              <%= subtitle %>
            </span>
          <% end %>
        </div>

        <% if actions? %>
          <%= actions %>
        <% end %>
      </div>

      <% if content %>
        <div class="md:w-1/2 flex justify-center items-center">
          <%= content %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col gap-8 <%= align_items_classes %>">
      <% if content %>
        <%= content %>
      <% end %>

      <% if actions? %>
        <%= actions %>
      <% end %>
    </div>
  <% end %>
  </div>
</section>