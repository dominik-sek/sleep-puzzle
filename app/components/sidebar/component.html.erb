<div class="<%= wrapper_classes %>" <%= tag.attributes(controller_data) %>>
  <!-- Mobile Sidebar Overlay -->
  <dialog id="<%= storage_key %>-mobile" class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none border-0 bg-transparent p-0 text-cream backdrop:bg-transparent" aria-label="Nawigacja panelu" data-sidebar-target="mobileSidebar" data-action="cancel->sidebar#cancelMobile keydown->sidebar#keepMobileFocus">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50 motion-safe:transition-opacity motion-safe:duration-300" data-sidebar-target="mobileBackdrop" data-action="click->sidebar#closeMobile"></div>

    <!-- Sidebar Panel -->
    <div class="<%= mobile_panel_classes %>" data-sidebar-target="mobilePanel">
      <div data-sidebar-target="sharedContent"></div>
    </div>
  </dialog>

  <div class="relative z-0 flex h-full w-full">
    <div class="relative flex h-full flex-row">
      <% if collapsible? %>
        <details class="<%= sidebar_classes %>" data-sidebar-target="desktopSidebar">
          <!-- Collapsed Sidebar Summary -->
          <summary class="group-open/sidebar:hidden flex <%= min_height_class %> h-full cursor-e-resize list-none flex-col items-start pl-2 pr-1.5">
            <div class="flex h-13 w-full items-center justify-start">
              <button class="cursor-e-resize flex size-11 items-center justify-center rounded-lg text-taupe hover:bg-ink-soft hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus-visible:bg-ink-soft disabled:opacity-50 sm:size-11" data-action="click->sidebar#open" aria-label="Rozwiń nawigację">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 sm:size-4.5" width="18" height="18" viewBox="0 0 18 18"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><line x1="6.25" y1="2.75" x2="6.25" y2="15.25"></line><polyline points="10.25 6.5 12.75 9 10.25 11.5"></polyline><rect x="1.75" y="2.75" width="14.5" height="12.5" rx="2" ry="2" transform="translate(18 18) rotate(180)"></rect></g></svg>
              </button>
            </div>

            <!-- Collapsed Nav Items -->
            <div class="mt-1.5 sm:mt-2 flex w-full flex-col items-start">
              <% items.each do |item| %>
                <a href="<%= item.href %>" aria-label="<%= item.label %>" data-controller="tooltip" data-tooltip-content="<%= item.label %>" data-tooltip-placement-value="right" data-tooltip-arrow="true" data-tooltip-animation-value="fade origin" data-tooltip-size-value="small" class="<%= item.collapsed_item_classes %>">
                  <% if item.icon? %>
                    <%= item.icon.html_safe %>
                  <% else %>
                    <span class="size-4 sm:size-4.5 flex items-center justify-center text-xs font-medium"><%= item.label.first.upcase %></span>
                  <% end %>
                </a>
              <% end %>
            </div>

            <div class="flex-grow"></div>

            <!-- Collapsed Footer -->
            <% if footer? || collapsed_footer? %>
              <div class="<%= collapsed_footer_classes %>">
                <%= collapsed_footer? ? collapsed_footer : footer %>
              </div>
            <% end %>
          </summary>

          <!-- Expanded Sidebar Content -->
          <div class="<%= content_classes %>" data-sidebar-target="desktopContent">
            <!-- Shared Sidebar Content Template -->
            <template data-sidebar-target="contentTemplate">
              <nav class="<%= nav_classes %>">
                <div class="<%= header_classes %>">
                  <div class="px-1.5 sm:px-2">
                    <div class="flex h-13 items-center justify-between">
                      <!-- Logo -->
                      <% if logo? %>
                        <%= logo %>
                      <% end %>
                      <div class="flex">
                        <button class="flex size-11 cursor-w-resize items-center justify-center rounded-lg text-taupe hover:bg-ink-soft hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus-visible:bg-ink-soft disabled:opacity-50 sm:size-11" aria-expanded="true" aria-label="Zwiń nawigację" data-state="closed" data-action="click->sidebar#close">
                          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 sm:size-4.5" width="18" height="18" viewBox="0 0 18 18"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><line x1="11.75" y1="2.75" x2="11.75" y2="15.25"></line><polyline points="7.75 6.5 5.25 9 7.75 11.5"></polyline><rect x="1.75" y="2.75" width="14.5" height="12.5" rx="2" ry="2"></rect></g></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Main Nav Items -->
                <aside class="relative p-1.5 last:mb-5 sm:p-2 <%= variant == :minimal ? '' : 'bg-surface-dark' %>">
                  <% items.each do |item| %>
                    <%= item %>
                  <% end %>
                </aside>

                <!-- Sections -->
                <% sections.each do |section| %>
                  <%= section %>
                <% end %>

                <div class="grow"></div>

                <!-- Footer -->
                <% if footer? %>
                  <div class="<%= footer_classes %>">
                    <%= footer %>
                  </div>
                <% end %>
              </nav>
            </template>
          </div>
        </details>
      <% else %>
        <!-- Non-collapsible Sidebar -->
        <div class="<%= sidebar_classes.gsub('group/sidebar', '') %>" data-sidebar-target="desktopSidebar">
          <nav class="<%= nav_classes %>">
            <div class="<%= header_classes %>">
              <div class="px-1.5 sm:px-2">
                <div class="flex h-13 items-center justify-between">
                  <% if logo? %>
                    <%= logo %>
                  <% end %>
                </div>
              </div>
            </div>

            <aside class="relative p-1.5 last:mb-5 sm:p-2">
              <% items.each do |item| %>
                <%= item %>
              <% end %>
            </aside>

            <% sections.each do |section| %>
              <%= section %>
            <% end %>

            <div class="grow"></div>

            <% if footer? %>
              <div class="<%= footer_classes %>">
                <%= footer %>
              </div>
            <% end %>
          </nav>
        </div>
      <% end %>
    </div>

    <!-- Main Content Area -->
    <main class="<%= min_height_class %> min-w-0 grow w-auto bg-ink flex flex-col relative overflow-y-auto">
      <% if show_mobile_toggle? %>
        <div class="w-full shrink-0 sticky top-0 z-30 flex items-center bg-ink md:hidden p-2">
          <button type="button" class="size-11 shrink-0 inline-flex items-center justify-center rounded-md text-cream focus:bg-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:opacity-50" data-action="click->sidebar#openMobile" aria-label="Otwórz nawigację" aria-haspopup="dialog" aria-expanded="false" data-sidebar-target="mobileToggle" aria-controls="<%= storage_key %>-mobile">
            <span class="sr-only">Otwórz nawigację</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 sm:size-4.5" width="18" height="18" viewBox="0 0 18 18"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><line x1="2.25" y1="9" x2="15.75" y2="9"></line><line x1="2.25" y1="3.75" x2="15.75" y2="3.75"></line><line x1="2.25" y1="14.25" x2="8.25" y2="14.25"></line></g></svg>
          </button>
        </div>
      <% end %>
      <%= content %>
    </main>
  </div>
</div>
