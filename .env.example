# Postgres connection. Blank username/password means peer auth as the OS user.
# DATABASE_URL, if set, overrides all of these.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
TEST_DATABASE_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
# Runs the Solid Queue supervisor inside Puma. Without it there is no worker at
# all: mail sits in the queue undelivered and Paddle's webhooks are stored but
# never processed, so a paid booking stays "pending". Kamal sets it in
# config/deploy.yml; anywhere else it has to be set by hand.
SOLID_QUEUE_IN_PUMA=true
# Worker threads, and part of the connection pool in database.yml — they share
# Puma's pool in :async mode. Lower it on a memory-tight instance.
JOB_THREADS=3
PADDLE_BILLING_ENVIRONMENT=sandbox
PADDLE_BILLING_API_KEY=
PADDLE_BILLING_CLIENT_TOKEN=
PADDLE_BILLING_SIGNING_SECRET=
MAIL_FROM=
# Where booking and contact mail lands, and the reply-to fallback. This is an
# inbox, not a permission: admin access is the `admin` flag on a user, granted
# with `bin/rails 'admin:promote[you@example.com]'`.
OWNER_EMAIL=
MAIL_REPLY_TO=
APP_HOST=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
# Brevo holds the newsletter list. The list id says what the home-page form
# subscribes to; the template id is the double opt-in mail Brevo sends, which
# has to be a DOI template rather than a plain campaign one.
# Also the transactional mail transport: with this set, mail goes out over
# Brevo's HTTP API instead of SMTP, which is what makes it work on hosts that
# block outbound SMTP. Unset, mail falls back to the SMTP_* settings above.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
BUNNY_CDN_HOST=
BUNNY_CDN_TOKEN=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# only if the storage zone is outside Falkenstein, e.g. ny.storage.bunnycdn.com
BUNNY_STORAGE_HOST=

# Rails session/cookie signing. This app keeps every secret in ENV, so
# secret_key_base comes from here rather than encrypted credentials.
# Generate one with `bin/rails secret`; changing it invalidates all sessions.
# Only needed locally if you boot with RAILS_ENV=production. The deployed value
# is a different one, in .env.production, which is what Kamal ships.
SECRET_KEY_BASE=
